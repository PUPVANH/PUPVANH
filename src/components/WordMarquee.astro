<div class="word-marquee">
  <div class="word-track">
    <span>photos<div class="dm"></div>caps<div class="dm"></div><em>build</em><div class="dm"></div>poems<div class="dm"></div>ideas<div class="dm"></div>football<div class="dm"></div></span>
    <span>photos<div class="dm"></div>caps<div class="dm"></div><em>build</em><div class="dm"></div>poems<div class="dm"></div>ideas<div class="dm"></div>football<div class="dm"></div></span>
  </div>
</div>

<style>
  .word-marquee{
    overflow:hidden;padding:60px 0;
    background:var(--forest-deep);color:#F4F0E8;position:relative;
  }
  :global(html[data-mode="dark"]) .word-marquee{background:var(--card);color:var(--text);}
  .word-marquee::before{
    content:'';position:absolute;inset:0;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>");
    opacity:.08;mix-blend-mode:screen;pointer-events:none;
  }
  :global(html[data-mode="dark"]) .word-marquee::before{mix-blend-mode:multiply;opacity:.05;}

  .word-track{
    display:inline-flex;gap:60px;
    animation:scroll 45s linear infinite;
    white-space:nowrap;
    font-size:clamp(80px,14vw,190px);font-weight:800;letter-spacing:-.045em;
    position:relative;z-index:1;
  }
  .word-track:hover{animation-play-state:paused;}
  .word-track span{display:inline-flex;align-items:center;gap:60px;}
  .word-track em{color:var(--gold);font-style:italic;font-weight:400;}
  .word-track .dm{
    width:16px;height:16px;background:var(--ember);
    transform:rotate(45deg);flex-shrink:0;transition:transform .3s;
  }
  .word-track:hover .dm{transform:rotate(135deg);}
  @keyframes scroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}

  @media(max-width:800px){
    .word-marquee{padding:40px 0;}
  }
</style>
