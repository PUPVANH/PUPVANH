---
---
<nav>
  <div class="nav-l" id="logoTrigger">
    <span class="dot"></span>
    <span>PUPVANH</span>
  </div>
  <div class="nav-c">
    <a href="/notes">notes</a>
    <a href="/bookmarks">bookmarks</a>
    <a href="/jpg">jpg</a>
    <span class="cat-sep" aria-hidden="true">•&nbsp;•&nbsp;•</span>
    <a href="/ariba">ariba</a>
    <a href="https://siviez.com" target="_blank" rel="noopener" class="ext">siviez ↗</a>
    <a href="/flags">flags</a>
    <a href="/pups">pups</a>
  </div>
  <div class="nav-r">
    <span class="vol-label">2026 · vol.01</span>
    <button class="theme-toggle" id="tb" aria-label="Toggle dark mode">◐</button>
    <button class="hamburger" id="hb" aria-label="Open menu" aria-expanded="false">☰</button>
  </div>
</nav>

<!-- Mobile overlay menu -->
<div class="mobile-menu" id="mm" aria-hidden="true">
  <div class="mm-overlay" data-close></div>
  <div class="mm-panel" role="dialog" aria-modal="true">
    <button class="mm-close" data-close aria-label="Close menu">×</button>
    <nav class="mm-links">
      <a href="/notes" data-close>notes</a>
      <a href="/bookmarks" data-close>bookmarks</a>
      <a href="/jpg" data-close>jpg</a>
      <span class="mm-sep" aria-hidden="true">•&nbsp;•&nbsp;•</span>
      <a href="/ariba" data-close>ariba</a>
      <a href="https://siviez.com" target="_blank" rel="noopener" data-close class="ext">siviez ↗</a>
      <a href="/flags" data-close>flags</a>
      <a href="/pups" data-close>pups</a>
    </nav>
    <div class="mm-foot">
      <span>2026 · vol.01</span>
    </div>
  </div>
</div>

<div class="pup" id="pup">🐕</div>
<style>
  nav{
    position:fixed;top:0;left:0;right:0;z-index:60;
    display:flex;justify-content:space-between;align-items:center;
    padding:20px 32px;background:rgba(244,240,232,.85);
    backdrop-filter:blur(12px);
    font-family:'JetBrains Mono',monospace;font-size:13px;
  }
  :global(html[data-mode="dark"]) nav{background:rgba(18,37,34,.85);}
  .nav-l{display:flex;align-items:center;gap:10px;position:relative;cursor:pointer;}
  .nav-l .dot{width:8px;height:8px;background:var(--ember);border-radius:50%;animation:pulse 2s ease-in-out infinite;}
  .nav-l::after{
    content:'// hover me';position:absolute;left:calc(100% + 10px);top:50%;
    transform:translateY(-50%);font-size:10px;color:var(--muted);
    opacity:0;transition:opacity .3s;white-space:nowrap;pointer-events:none;
  }
  .nav-l:hover::after{opacity:.6;}
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(.85);}}
  .nav-c{display:flex;gap:24px;font-size:12px;color:var(--muted);align-items:center;}
  .nav-c a{color:var(--muted);text-decoration:none;transition:color .2s;}
  .nav-c a:hover{color:var(--accent);}
  .nav-c a.ext{color:var(--gold);}
  .nav-c a.ext:hover{color:var(--ember);}
  .cat-sep{color:var(--ember);font-size:10px;letter-spacing:1px;user-select:none;opacity:.75;}
  .nav-r{display:flex;gap:14px;align-items:center;font-size:12px;color:var(--muted);}
  .theme-toggle{background:transparent;border:none;color:var(--text);font-size:14px;cursor:pointer;font-family:inherit;}

  /* Hamburger — verborgen op desktop */
  .hamburger{
    display:none;background:transparent;border:none;color:var(--text);
    font-size:20px;cursor:pointer;font-family:inherit;padding:0;line-height:1;
  }

  /* Mobile menu overlay */
  .mobile-menu{
    position:fixed;inset:0;z-index:100;display:none;
  }
  .mobile-menu.open{display:block;}
  .mm-overlay{
    position:absolute;inset:0;background:rgba(30,58,52,.6);
    backdrop-filter:blur(8px);cursor:pointer;
    animation:mmFadeIn .25s ease;
  }
  .mm-panel{
    position:absolute;top:0;right:0;bottom:0;
    width:min(320px,85vw);background:var(--bg);
    display:flex;flex-direction:column;
    padding:80px 32px 32px;
    box-shadow:-4px 0 24px rgba(0,0,0,.15);
    animation:mmSlideIn .3s cubic-bezier(.2,.8,.2,1);
  }
  :global(html[data-mode="dark"]) .mm-panel{background:#0F2622;}
  @keyframes mmFadeIn{from{opacity:0;}to{opacity:1;}}
  @keyframes mmSlideIn{from{transform:translateX(100%);}to{transform:translateX(0);}}
  .mm-close{
    position:absolute;top:20px;right:24px;
    background:transparent;border:none;color:var(--text);
    font-size:32px;cursor:pointer;padding:0;line-height:1;
    font-family:inherit;transition:transform .2s;
  }
  .mm-close:hover{transform:rotate(90deg);}
  .mm-links{
    display:flex;flex-direction:column;gap:20px;
    font-family:'JetBrains Mono',monospace;font-size:16px;
  }
  .mm-links a{
    color:var(--text);text-decoration:none;transition:color .2s;
    letter-spacing:.05em;
  }
  .mm-links a:hover{color:var(--ember);}
  .mm-sep{
    color:var(--ember);font-size:12px;letter-spacing:2px;
    opacity:.75;padding:8px 0;user-select:none;
  }
  .mm-foot{
    margin-top:auto;padding-top:24px;
    font-family:'JetBrains Mono',monospace;font-size:11px;
    color:var(--muted);letter-spacing:.1em;
    border-top:1px solid rgba(232,93,47,.15);
  }

  body.mm-open{overflow:hidden;}

  .pup{position:fixed;top:22px;left:-80px;font-size:28px;z-index:200;pointer-events:none;opacity:0;}
  .pup.run{opacity:1;animation:pupRun 5s linear;}
  @keyframes pupRun{
    0%{transform:translateX(0) translateY(0) rotate(0);}
    25%{transform:translateX(30vw) translateY(-2px) rotate(-3deg);}
    50%{transform:translateX(60vw) translateY(-5px) rotate(4deg);}
    75%{transform:translateX(85vw) translateY(-2px) rotate(-2deg);}
    100%{transform:translateX(110vw) translateY(0) rotate(0);}
  }
  @media(max-width:800px){
    nav{padding:14px 20px;}
    .nav-c{display:none;}
    .vol-label{display:none;}
    .hamburger{display:inline-block;}
  }
</style>
<script>
  // Dark mode toggle met localStorage persistence
  const tb = document.getElementById('tb');
  if (tb) {
    // Load saved mode
    const savedMode = localStorage.getItem('pupvanh-mode');
    if (savedMode) {
      document.documentElement.setAttribute('data-mode', savedMode);
      tb.textContent = savedMode === 'dark' ? '◑' : '◐';
    }
    // Save on toggle
    tb.addEventListener('click', () => {
      const r = document.documentElement;
      const c = r.getAttribute('data-mode');
      const n = c === 'dark' ? 'light' : 'dark';
      r.setAttribute('data-mode', n);
      tb.textContent = n === 'dark' ? '◑' : '◐';
      localStorage.setItem('pupvanh-mode', n);
    });
  }
  // Hamburger mobile menu
  const hb = document.getElementById('hb');
  const mm = document.getElementById('mm');
  if (hb && mm) {
    const openMenu = () => {
      mm.classList.add('open');
      mm.setAttribute('aria-hidden', 'false');
      hb.setAttribute('aria-expanded', 'true');
      document.body.classList.add('mm-open');
    };
    const closeMenu = () => {
      mm.classList.remove('open');
      mm.setAttribute('aria-hidden', 'true');
      hb.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('mm-open');
    };
    hb.addEventListener('click', openMenu);
    mm.querySelectorAll('[data-close]').forEach(el => {
      el.addEventListener('click', closeMenu);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mm.classList.contains('open')) closeMenu();
    });
  }

  // Easter egg: sneaky pupje na 1s hover op logo
  const logoTrigger = document.getElementById('logoTrigger');
  const pupEl = document.getElementById('pup');
  let hoverTimer: ReturnType<typeof setTimeout> | null = null;
  if (logoTrigger && pupEl) {
    logoTrigger.addEventListener('mouseenter', () => {
      hoverTimer = setTimeout(() => {
        pupEl.classList.add('run');
        setTimeout(() => pupEl.classList.remove('run'), 5000);
      }, 1000);
    });
    logoTrigger.addEventListener('mouseleave', () => {
      if (hoverTimer) clearTimeout(hoverTimer);
    });
  }
</script>
