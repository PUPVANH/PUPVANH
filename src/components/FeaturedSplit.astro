<a href="/jpg" class="split-sec">
  <div class="split-inner">
    <div class="split-l">
      <p class="kicker">// featured this week</p>
      <h2>pups.jpg — <em>photographs on the road.</em></h2>
      <p>Thirty frames, four countries, one camera. A Fujifilm X100F carried through Slovenia, Italy, Switzerland and back home to Belgium. Filterable by place, viewable as grid or map.</p>
      <p class="frame-meta">→ open pups.jpg</p>
    </div>
    <div class="split-r"></div>
  </div>
</a>

<style>
  .split-sec{
    background:var(--forest);color:#F4F0E8;padding:0;
    position:relative;overflow:hidden;
    display:block;text-decoration:none;
  }
  :global(html[data-mode="dark"]) .split-sec{background:var(--card);color:var(--text);}
  .split-sec::before{
    content:'';position:absolute;inset:0;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>");
    opacity:.09;mix-blend-mode:screen;pointer-events:none;
  }
  :global(html[data-mode="dark"]) .split-sec::before{mix-blend-mode:multiply;opacity:.05;}

  .split-inner{
    max-width:1400px;margin:0 auto;
    display:grid;grid-template-columns:1fr 1fr;gap:0;
    position:relative;z-index:1;
  }
  .split-l{padding:120px 60px 120px 32px;}
  .split-r{
    background-image:linear-gradient(160deg,rgba(24,33,30,.15),rgba(24,33,30,.35)),url('/jpg/italy-01-dolomites.jpg');
    background-size:cover;background-position:center;
    min-height:600px;position:relative;overflow:hidden;
    transition:transform .8s ease;
  }
  .split-sec:hover .split-r{transform:scale(1.02);}
  .split-r::after{
    content:'// pups.jpg · 30 frames';position:absolute;
    bottom:24px;right:24px;
    font-family:'JetBrains Mono',monospace;font-size:11px;
    color:rgba(244,240,232,.75);letter-spacing:.1em;text-transform:uppercase;z-index:1;
  }

  .split-l .kicker{
    font-family:'JetBrains Mono',monospace;font-size:12px;
    color:var(--ember);margin-bottom:24px;letter-spacing:.05em;text-transform:uppercase;
  }
  .split-l h2{
    font-size:clamp(36px,5vw,64px);font-weight:700;
    letter-spacing:-.02em;line-height:1.05;margin-bottom:20px;
  }
  .split-l h2 em{color:var(--gold);font-style:italic;font-weight:400;}
  .split-l p{
    font-size:16px;color:rgba(244,240,232,.75);
    line-height:1.7;margin-bottom:16px;max-width:440px;
  }
  :global(html[data-mode="dark"]) .split-l p{color:var(--muted);}
  .split-l .frame-meta{
    font-family:'JetBrains Mono',monospace;font-size:11px;
    color:rgba(244,240,232,.55);margin-top:24px;letter-spacing:.05em;
    transition:color .2s,transform .2s;cursor:pointer;display:inline-block;
  }
  .split-l .frame-meta:hover{color:var(--ember);transform:translateX(6px);}
  :global(html[data-mode="dark"]) .split-l .frame-meta{color:var(--muted);}

  @media(max-width:800px){
    .split-inner{grid-template-columns:1fr;}
    .split-l{padding:60px 20px;}
    .split-r{min-height:300px;}
  }
</style>
