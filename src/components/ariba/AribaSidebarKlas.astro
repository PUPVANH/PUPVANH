---
import data from '../../data/ariba-klassementen.json';

// Zelfde berekening als in AribaKlassement.astro (hou beide gelijk):
//  - gsp = w + g + v | pt = 3 x w + g | ds = dv - dt
//  - volgorde: punten, dan doelsaldo, dan doelpunten voor
function bereken(rijen: any[]) {
  const rows = rijen.map((r: any) => {
    const w = r.w ?? 0, g = r.g ?? 0, v = r.v ?? 0;
    const dv = r.dv ?? 0, dt = r.dt ?? 0;
    return { ...r, w, g, v, dv, dt, gsp: r.gsp ?? (w + g + v), pt: r.pt ?? (3 * w + g), ds: dv - dt };
  });
  if (!rows.every((r: any) => r.pos != null)) {
    rows.sort((a: any, b: any) => b.pt - a.pt || b.ds - a.ds || b.dv - a.dv || a.ploeg.localeCompare(b.ploeg));
    rows.forEach((r: any, i: number) => { r.pos = i + 1; });
  }
  return rows;
}

// Vind huidig seizoen en bereken het klassement
const huidigRuw = data.seizoenen.find((s: any) => s.actief) || data.seizoenen[0];
const huidig = { ...huidigRuw, rijen: bereken(huidigRuw.rijen) };

// Vind Ariba positie
const arIdx = huidig.rijen.findIndex((r: any) => r.us);

// Bepaal welke rijen te tonen:
// - Als Ariba #1: toon Ariba + 4 volgende (5 rijen totaal)
// - Anders: 2 boven, Ariba, 2 onder (max 5)
let start = 0;
let end = 5;
if (arIdx > 2) {
  start = arIdx - 2;
  end = start + 5;
}
if (end > huidig.rijen.length) {
  end = huidig.rijen.length;
  start = Math.max(0, end - 5);
}
const zichtbaar = huidig.rijen.slice(start, end);

function shortName(n: string) {
  if (n.length <= 18) return n;
  return n.slice(0, 16) + '…';
}
---

<div class="ariba-side-card">
  <div class="ariba-side-header">
    <span class="ariba-side-kicker">Klassement</span>
    {huidig.actief && <span class="ariba-side-live">LIVE</span>}
  </div>
  <div class="ariba-side-sub">{huidig.seizoen} · {huidig.reeks}</div>
  <table class="ariba-side-table">
    <tbody>
      {zichtbaar.map((r: any) => (
        <tr class={r.us ? 'us' : ''}>
          <td>{r.pos}</td>
          <td>{shortName(r.ploeg)}</td>
          <td>{r.pt}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <button class="ariba-side-more" data-modal="modalKlas">
    Volledig klassement →
  </button>
</div>
