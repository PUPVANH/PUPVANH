---
const menu = [
  { href: '#ariba-kalender', label: 'Kalender' },
  { href: '#ariba-selectie', label: 'Selectie' },
  { href: '#ariba-bestuur', label: 'Bestuur' },
  { href: '#ariba-geschiedenis', label: 'Geschiedenis' },
  { href: '#ariba-verhaal', label: 'Ons verhaal' },
  { href: '#ariba-sponsors', label: 'Sponsors' },
];
---
<nav class="ariba-nav">
  <button class="ariba-hamburger" id="aribaHamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
  <div class="ariba-nav-center">
    <div class="ariba-nav-title">
      <img src="/ariba/fc-ariba-logo.svg" alt="Fc Ariba" />
      <span class="bebas">Fc Ariba</span>
    </div>
    <a href="https://www.instagram.com/fc.ariba" target="_blank" rel="noopener" class="ariba-nav-social" aria-label="Instagram">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
    </a>
    <a href="https://www.facebook.com/p/FC-Ariba-100085398263472/" target="_blank" rel="noopener" class="ariba-nav-social" aria-label="Facebook">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
    </a>
  </div>
  <div class="ariba-nav-right">
    <span class="ariba-nav-season">2026-27 · reeks 1</span>
  </div>
  <div class="ariba-menu" id="aribaMenu" aria-hidden="true">
    <ul>{menu.map(m => (<li><a href={m.href} class="ariba-menu-link">{m.label}</a></li>))}</ul>
  </div>
  <div class="ariba-menu-overlay" id="aribaMenuOverlay"></div>
</nav>

<script is:inline>
  (function(){
    const hb = document.getElementById('aribaHamburger');
    const menu = document.getElementById('aribaMenu');
    const overlay = document.getElementById('aribaMenuOverlay');
    if (!hb || !menu || !overlay) return;
    function close(){ menu.classList.remove('open'); overlay.classList.remove('open'); hb.classList.remove('open'); }
    function toggle(){
      const isOpen = menu.classList.toggle('open');
      overlay.classList.toggle('open', isOpen);
      hb.classList.toggle('open', isOpen);
    }
    hb.addEventListener('click', toggle);
    overlay.addEventListener('click', close);
    document.querySelectorAll('.ariba-menu-link').forEach(a => a.addEventListener('click', close));
  })();
</script>
