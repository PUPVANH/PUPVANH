---
import data from '../../data/ariba-klassementen.json';

// Berekent per ploeg: gespeeld, punten en doelsaldo, en bepaalt de positie.
//  - gsp = w + g + v            (tenzij 'gsp' handmatig in het bestand staat)
//  - pt  = 3 x w + g            (tenzij 'pt' handmatig in het bestand staat)
//  - ds  = dv - dt
//  - volgorde: punten, dan doelsaldo, dan doelpunten voor
// Seizoenen waar ELKE ploeg al een vaste 'pos' heeft (oude seizoenen) worden niet herordend.
function bereken(rijen: any[]) {
  const rows = rijen.map((r: any) => {
    const w = r.w ?? 0, g = r.g ?? 0, v = r.v ?? 0;
    const dv = r.dv ?? 0, dt = r.dt ?? 0;
    return { ...r, w, g, v, dv, dt, gsp: r.gsp ?? (w + g + v), pt: r.pt ?? (3 * w + g), ds: dv - dt };
  });
  if (!rows.every((r: any) => r.pos != null)) {
    rows.sort((a: any, b: any) => b.pt - a.pt || b.ds - a.ds || b.dv - a.dv || a.ploeg.localeCompare(b.ploeg));
    rows.forEach((r: any, i: number) => { r.pos = i + 1; });
  }
  return rows;
}

// Klassementen: seizoen voor seizoen, met berekende rijen
const seizoenen = data.seizoenen.map((s: any) => ({ ...s, rijen: bereken(s.rijen) }));
---

<section class="ariba-klassement-sec" id="ariba-klassement">
  <p class="ariba-section-kicker">Klassement</p>
  <h2 class="ariba-section-title">Waar we <em>staan</em></h2>
  <p class="ariba-section-sub">Huidig seizoen · en de historie</p>

  <div class="ariba-klas-tabs" role="tablist">
    {seizoenen.map((s, i) => (
      <button
        class={`ariba-klas-tab${i === 0 ? ' active' : ''}${s.actief ? ' actief' : ''}`}
        data-tab={s.seizoen}
        role="tab"
      >
        {s.seizoen}
        {s.actief && <span class="ariba-klas-live">LIVE</span>}
      </button>
    ))}
  </div>

  {seizoenen.map((s, i) => (
    <div class={`ariba-klas-panel${i === 0 ? ' active' : ''}`} data-panel={s.seizoen}>
      <div class="ariba-klas-header">
        <h3>{s.reeks}</h3>
        <span>Seizoen {s.seizoen}{s.actief ? ' · lopend' : ''}</span>
      </div>
      {s.opmerking && (
        <p class="ariba-klas-note">ℹ️ {s.opmerking}</p>
      )}
      <div class="ariba-klas-table-wrap">
        <table class="ariba-table">
          <thead>
            <tr>
              <th>#</th><th>Ploeg</th><th>Gsp</th><th>W</th><th>G</th>
              <th>V</th><th>DV</th><th>DT</th><th>DS</th><th>Pt</th>
            </tr>
          </thead>
          <tbody>
            {s.rijen.map((r: any) => (
              <tr class={r.us ? 'us' : ''}>
                <td>{r.pos}</td>
                <td>{r.ploeg}</td>
                <td>{r.gsp}</td>
                <td>{r.w}</td>
                <td>{r.g}</td>
                <td>{r.v}</td>
                <td>{r.dv}</td>
                <td>{r.dt}</td>
                <td>{r.ds > 0 ? `+${r.ds}` : r.ds}</td>
                <td>{r.pt}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}
</section>

<style>
  /* Op smalle schermen: V en DV zijn al verborgen (ariba.css), DT ook, zodat DS en Pt overblijven */
  @media (max-width: 800px) {
    .ariba-table th:nth-child(8),
    .ariba-table td:nth-child(8) { display: none; }
  }
</style>

<script is:inline>
  (function(){
    const tabs = document.querySelectorAll('.ariba-klas-tab');
    const panels = document.querySelectorAll('.ariba-klas-panel');
    tabs.forEach(t => {
      t.addEventListener('click', () => {
        const key = t.getAttribute('data-tab');
        tabs.forEach(x => x.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        t.classList.add('active');
        const panel = document.querySelector(`.ariba-klas-panel[data-panel="${key}"]`);
        if (panel) panel.classList.add('active');
      });
    });
  })();
</script>
