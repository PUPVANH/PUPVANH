---
import data from '../../data/ariba-spelers.json';

function topschutters(seizoen: string) {
  return data.spelers
    .filter((sp: any) => sp.seizoenen?.[seizoen])
    .map((sp: any) => ({
      naam: sp.naam,
      goals: sp.seizoenen[seizoen].goals ?? 0,
      foto: sp.foto ?? null,
    }))
    .filter((sp: any) => sp.goals > 0)
    .sort((a: any, b: any) => b.goals - a.goals);
}

function initials(n: string) {
  const p = n.trim().split(/\s+/);
  return (p[0][0] + (p[p.length - 1][0] || '')).toUpperCase();
}

// Huidig seizoen: 26-27. Als leeg, toon top 3 van vorig seizoen als teaser.
const topNow = topschutters('2026-27').slice(0, 3);
const topPrev = topschutters('2025-26').slice(0, 3);
const showFallback = topNow.length === 0;
const list = showFallback ? topPrev : topNow;
---

<div class="ariba-side-card">
  <div class="ariba-side-header">
    <span class="ariba-side-kicker">Topschutters</span>
    <span class="ariba-side-live">LIVE</span>
  </div>
  <div class="ariba-side-sub">2026-27</div>
  <div class="ariba-side-topsc-list">
    {showFallback && (
      <div class="ariba-side-topsc-empty" style="padding:12px 0; line-height:1.5;">
        Aftrap MA 14 sept<br/>
        <span style="color:var(--ar-gold);">Top 3 van 25-26 →</span>
      </div>
    )}
    {list.map((sp, i) => (
      <div class={`ariba-side-topsc-row ${i === 0 ? 'gold' : 'silver'}`}>
        <div class="ariba-side-topsc-rank">{i + 1}</div>
        <div class="ariba-side-topsc-avatar">
          {sp.foto ? <img src={sp.foto} alt={sp.naam} /> : <span>{initials(sp.naam)}</span>}
        </div>
        <div class="ariba-side-topsc-info">
          <div class="ariba-side-topsc-name">{sp.naam}</div>
          <div class="ariba-side-topsc-goals">{sp.goals} goals</div>
        </div>
      </div>
    ))}
  </div>
  <button class="ariba-side-more" data-modal="modalTopsc">Alle topschutters →</button>
</div>
