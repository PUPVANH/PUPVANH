---
const jaar = new Date().getFullYear();
---

<footer class="ariba-footer-block">
  <div class="ariba-footer-meta">
    <div class="ariba-footer-line">BUILT AUG 2026 · UPDATED AUG 2026</div>
    <div class="ariba-footer-name">FC ARIBA</div>
    <div class="ariba-footer-line">Part of PUPVANH Projects</div>
    <div class="ariba-footer-link"><a href="/">→ pupvanh.vercel.app</a></div>
  </div>
  <div class="ariba-footer-copy">© {jaar} Fc Ariba · MVBI Izegem</div>
</footer>

<script is:inline>
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.ariba-reveal').forEach(el => obs.observe(el));
</script>
