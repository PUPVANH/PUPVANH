---
const seizoenen = [
  {
    jaar: '2022-23', reeks: 'Reeks 3', positie: '1e plaats', badge: 'Promotie', type: 'promotion',
    detail: '19 gewonnen, 2 gelijk, 0 verloren · 210 goals voor, 55 tegen · 59 punten. Eerste seizoen, meteen 1e — promotie afgedwongen naar reeks 1.',
  },
  {
    jaar: '2023-24', reeks: 'Reeks 1', positie: '1e plaats', badge: 'Kampioen', type: 'champion',
    detail: '21 gewonnen, 2 gelijk, 3 verloren · 180 goals voor, 90 tegen · 65 punten. Debuutseizoen in de hoogste reeks, meteen de titel gepakt.',
  },
  {
    jaar: '2024-25', reeks: 'Reeks 1', positie: '1e plaats', badge: 'Kampioen', type: 'champion',
    detail: '18 gewonnen, 2 gelijk, 1 verloren · 143 goals voor, 65 tegen · 56 punten. Tweede titel op rij. (T\'Bloemgat stond ten onrechte in het klassement — zij deden niet mee.)',
  },
  {
    jaar: '2025-26', reeks: 'Reeks 1', positie: '2e plaats', badge: null, type: '',
    detail: '16 gewonnen, 1 gelijk, 3 verloren · 159 goals voor, 78 tegen · 49 punten. Nipt naast de titel — Vloerwerken Slambrouck ging er met de winst vandoor.',
  },
  {
    jaar: '2026-27', reeks: null, positie: 'Nu bezig', badge: null, type: '',
    detail: 'Op naar seizoen vijf. Aftrap op maandag 14 september 2026.',
  },
];
---

<section class="ariba-history" id="ariba-geschiedenis">
  <p class="ariba-section-kicker">Geschiedenis</p>
  <h2 class="ariba-section-title">Vier seizoenen, <em>twee titels.</em></h2>
  <p class="ariba-section-sub">Van reeks 3 naar de top van reeks 1</p>

  <div class="ariba-timeline">
    {seizoenen.map(s => (
      <div class={`ariba-season ariba-reveal ${s.type}`}>
        <div class="ariba-season-header">
          <span class="ariba-season-year">{s.jaar}</span>
          <span class="ariba-season-position">
            {s.reeks && (<>{s.reeks} · </>)}
            <em>{s.positie}</em>
            {s.badge && (
              <span class={`ariba-season-badge${s.type === 'promotion' ? ' promo' : ''}`}>
                {s.badge}
              </span>
            )}
          </span>
        </div>
        <p class="ariba-season-detail">{s.detail}</p>
      </div>
    ))}
  </div>
</section>
