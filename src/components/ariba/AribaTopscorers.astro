---
import data from '../../data/ariba-topschutters.json';

// Helper: initialen ophalen uit naam voor placeholder
function initials(name: string) {
  if (!name || name === 'TBD') return '?';
  const parts = name.trim().split(/\s+/);
  return (parts[0][0] + (parts[parts.length - 1][0] || '')).toUpperCase();
}
---

<section class="ariba-topsc-sec" id="ariba-topschutters">
  <p class="ariba-section-kicker">Topschutters</p>
  <h2 class="ariba-section-title">Doelpunten- <em>makers</em></h2>
  <p class="ariba-section-sub">Wie vindt het net het vaakst</p>

  <div class="ariba-topsc-tabs" role="tablist">
    {data.seizoenen.map((s: any, i: number) => (
      <button
        class={`ariba-topsc-tab${i === 0 ? ' active' : ''}${s.actief ? ' actief' : ''}`}
        data-tab={s.seizoen}
        role="tab"
      >
        {s.seizoen}
        {s.actief && <span class="ariba-topsc-live">LIVE</span>}
      </button>
    ))}
  </div>

  {data.seizoenen.map((s: any, i: number) => {
    const top3 = s.spelers.slice(0, 3);
    const rest = s.spelers.slice(3);
    const isEmpty = s.spelers.length === 0;

    return (
      <div class={`ariba-topsc-panel${i === 0 ? ' active' : ''}`} data-panel={s.seizoen}>
        {isEmpty ? (
          <div class="ariba-topsc-empty">
            Nog geen data beschikbaar voor seizoen {s.seizoen}
          </div>
        ) : (
          <>
            <div class="ariba-podium">
              {/* Layout: 2 - 1 - 3 (klassiek podium) */}
              {top3[1] && (
                <div class="ariba-podium-spot silver" data-rank="2">
                  <div class="ariba-podium-rank">2</div>
                  <div class="ariba-podium-photo">
                    {top3[1].foto ? (
                      <img src={top3[1].foto} alt={top3[1].naam} />
                    ) : (
                      <span class="ariba-podium-initials">{initials(top3[1].naam)}</span>
                    )}
                  </div>
                  <div class="ariba-podium-name">{top3[1].naam}</div>
                  <div class="ariba-podium-goals">{top3[1].goals} <span>goals</span></div>
                </div>
              )}
              {top3[0] && (
                <div class="ariba-podium-spot gold" data-rank="1">
                  <div class="ariba-podium-crown">★</div>
                  <div class="ariba-podium-rank">1</div>
                  <div class="ariba-podium-photo">
                    {top3[0].foto ? (
                      <img src={top3[0].foto} alt={top3[0].naam} />
                    ) : (
                      <span class="ariba-podium-initials">{initials(top3[0].naam)}</span>
                    )}
                  </div>
                  <div class="ariba-podium-name">{top3[0].naam}</div>
                  <div class="ariba-podium-goals">{top3[0].goals} <span>goals</span></div>
                </div>
              )}
              {top3[2] && (
                <div class="ariba-podium-spot silver" data-rank="3">
                  <div class="ariba-podium-rank">3</div>
                  <div class="ariba-podium-photo">
                    {top3[2].foto ? (
                      <img src={top3[2].foto} alt={top3[2].naam} />
                    ) : (
                      <span class="ariba-podium-initials">{initials(top3[2].naam)}</span>
                    )}
                  </div>
                  <div class="ariba-podium-name">{top3[2].naam}</div>
                  <div class="ariba-podium-goals">{top3[2].goals} <span>goals</span></div>
                </div>
              )}
            </div>

            {rest.length > 0 && (
              <div class="ariba-topsc-more">
                <button class="ariba-topsc-toggle" data-target={s.seizoen}>
                  Bekijk volledig overzicht <span>↓</span>
                </button>
                <div class="ariba-topsc-full" data-full={s.seizoen}>
                  <table class="ariba-table">
                    <thead>
                      <tr><th>#</th><th>Speler</th><th>Goals</th></tr>
                    </thead>
                    <tbody>
                      {s.spelers.map((sp: any, idx: number) => (
                        <tr class={idx === 0 ? 'us' : ''}>
                          <td>{idx + 1}</td>
                          <td>{sp.naam}</td>
                          <td>{sp.goals}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </>
        )}
      </div>
    );
  })}
</section>

<script is:inline>
  (function(){
    // Tab switching
    const tabs = document.querySelectorAll('.ariba-topsc-tab');
    const panels = document.querySelectorAll('.ariba-topsc-panel');
    tabs.forEach(t => {
      t.addEventListener('click', () => {
        const key = t.getAttribute('data-tab');
        tabs.forEach(x => x.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        t.classList.add('active');
        const panel = document.querySelector(`.ariba-topsc-panel[data-panel="${key}"]`);
        if (panel) panel.classList.add('active');
      });
    });

    // Uitklap volledig overzicht
    document.querySelectorAll('.ariba-topsc-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        const full = document.querySelector(`.ariba-topsc-full[data-full="${target}"]`);
        if (!full) return;
        const isOpen = full.classList.toggle('open');
        btn.classList.toggle('open', isOpen);
        btn.innerHTML = isOpen
          ? 'Verberg overzicht <span>↑</span>'
          : 'Bekijk volledig overzicht <span>↓</span>';
      });
    });
  })();
</script>
