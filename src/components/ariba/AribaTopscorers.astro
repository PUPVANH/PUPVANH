---
import data from '../../data/ariba-spelers.json';

const seizoenen = ['2026-27', '2025-26', '2024-25', '2023-24', '2022-23'];

function topschutters(seizoen: string) {
  return data.spelers
    .filter((sp: any) => sp.seizoenen?.[seizoen])
    .map((sp: any) => ({
      naam: sp.naam,
      goals: sp.seizoenen[seizoen].goals ?? 0,
      games: sp.seizoenen[seizoen].games,
      foto: sp.foto ?? null,
    }))
    .filter((sp: any) => sp.goals > 0)
    .sort((a: any, b: any) => b.goals - a.goals);
}

function initials(n: string) {
  if (!n) return '?';
  const p = n.trim().split(/\s+/);
  return (p[0][0] + (p[p.length - 1][0] || '')).toUpperCase();
}
---

<section class="ariba-topsc-sec" id="ariba-topschutters">
  <p class="ariba-section-kicker">Topschutters</p>
  <h2 class="ariba-section-title">Doelpunten- <em>makers</em></h2>
  <p class="ariba-section-sub">Wie vindt het net het vaakst</p>

  <div class="ariba-topsc-tabs" role="tablist">
    {seizoenen.map((sk, i) => {
      const isLive = sk === '2026-27';
      return (
        <button
          class={`ariba-topsc-tab${i === 0 ? ' active' : ''}${isLive ? ' actief' : ''}`}
          data-tab={sk}
          role="tab"
        >
          {sk}
          {isLive && <span class="ariba-topsc-live">LIVE</span>}
        </button>
      );
    })}
  </div>

  {seizoenen.map((sk, i) => {
    const list = topschutters(sk);
    const isLive = sk === '2026-27';
    return (
      <div class={`ariba-topsc-panel${i === 0 ? ' active' : ''}`} data-panel={sk}>
        {list.length === 0 ? (
          <div class="ariba-topsc-empty">
            {isLive ? 'Seizoen start MA 14 sept 2026' : `Nog geen data beschikbaar voor ${sk}`}
          </div>
        ) : (
          <>
            <div class="ariba-podium">
              {list[1] && (
                <div class="ariba-podium-spot silver" data-rank="2">
                  <div class="ariba-podium-rank">2</div>
                  <div class="ariba-podium-photo">
                    {list[1].foto ? <img src={list[1].foto} alt={list[1].naam} /> : <span class="ariba-podium-initials">{initials(list[1].naam)}</span>}
                  </div>
                  <div class="ariba-podium-name">{list[1].naam}</div>
                  <div class="ariba-podium-goals">{list[1].goals} <span>goals</span></div>
                </div>
              )}
              {list[0] && (
                <div class="ariba-podium-spot gold" data-rank="1">
                  <div class="ariba-podium-crown">★</div>
                  <div class="ariba-podium-rank">1</div>
                  <div class="ariba-podium-photo">
                    {list[0].foto ? <img src={list[0].foto} alt={list[0].naam} /> : <span class="ariba-podium-initials">{initials(list[0].naam)}</span>}
                  </div>
                  <div class="ariba-podium-name">{list[0].naam}</div>
                  <div class="ariba-podium-goals">{list[0].goals} <span>goals</span></div>
                </div>
              )}
              {list[2] && (
                <div class="ariba-podium-spot silver" data-rank="3">
                  <div class="ariba-podium-rank">3</div>
                  <div class="ariba-podium-photo">
                    {list[2].foto ? <img src={list[2].foto} alt={list[2].naam} /> : <span class="ariba-podium-initials">{initials(list[2].naam)}</span>}
                  </div>
                  <div class="ariba-podium-name">{list[2].naam}</div>
                  <div class="ariba-podium-goals">{list[2].goals} <span>goals</span></div>
                </div>
              )}
            </div>
            <div class="ariba-topsc-more" style="margin-top:32px;">
              <table class="ariba-table">
                <thead>
                  <tr><th>#</th><th>Speler</th><th>Games</th><th>Goals</th></tr>
                </thead>
                <tbody>
                  {list.map((p: any, idx: number) => (
                    <tr class={idx === 0 ? 'us' : ''}>
                      <td>{idx + 1}</td>
                      <td>{p.naam}</td>
                      <td>{p.games ?? '—'}</td>
                      <td>{p.goals}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
      </div>
    );
  })}
</section>

<script is:inline>
  (function(){
    const tabs = document.querySelectorAll('.ariba-topsc-tab');
    const panels = document.querySelectorAll('.ariba-topsc-panel');
    tabs.forEach(t => {
      t.addEventListener('click', () => {
        const key = t.getAttribute('data-tab');
        tabs.forEach(x => x.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        t.classList.add('active');
        const panel = document.querySelector(`.ariba-topsc-panel[data-panel="${key}"]`);
        if (panel) panel.classList.add('active');
      });
    });
  })();
</script>
