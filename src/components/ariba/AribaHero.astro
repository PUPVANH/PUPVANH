---
<section class="ariba-hero">
  <div class="ariba-hero-blob"></div>
  <div class="ariba-hero-inner">
    <img src="/ariba/fc-ariba-logo.svg" alt="FC Ariba" class="ariba-hero-logo" />
    <h1 class="ariba-hero-title">FC <em>Ariba</em></h1>
    <p class="ariba-hero-meta">
      MVBI Izegem <span class="dot"></span> Reeks 1 <span class="dot"></span> Sinds 2022
    </p>
    <div class="ariba-hero-stats">
      <div class="ariba-hero-stat"><span class="num">2</span><span class="lbl">Titels</span></div>
      <div class="ariba-hero-stat"><span class="num">1</span><span class="lbl">Promotie</span></div>
      <div class="ariba-hero-stat"><span class="num">65</span><span class="lbl">Wins</span></div>
      <div class="ariba-hero-stat"><span class="num">533</span><span class="lbl">Goals</span></div>
    </div>
  </div>
  <div class="ariba-scroll-hint">scroll</div>
</section>
