---
const items = [
  { n: '01', img: 'photos', href: '/jpg', bg: '/jpg/italy-04-venice-canal.jpg', title: 'pups.jpg — <em>photographs on the road</em>', kind: 'photos', date: '30 frames' },
  { n: '02', img: 'pups',   href: '/pups',    title: 'po.pups — <em>dog-inspired streetwear</em>', kind: 'project', date: 'via DM only' },
  { n: '03', img: 'siviez', href: '/siviez',  bg: '/jpg/ch-03-resort.jpg', title: 'Rosablanche C34 — <em>Siviez, Swiss Alps</em>', kind: 'project', date: 'live on Airbnb' },
  { n: '04', img: 'ariba',  href: '/ariba',   bg: '/ariba/fc-ariba-logo.svg', bgFit: 'contain', title: 'FC Ariba — <em>MVBI Izegem, reeks 1</em>', kind: 'project', date: 'since 2022' },
  { n: '05', img: 'bookmarks', symbol: '★', href: '/bookmarks', title: 'Bookmarks — <em>worth your click</em>', kind: 'bookmarks', date: '4 links' },
  { n: '06', img: 'text', symbol: '✎', href: '/notes', title: 'Notes — <em>rants, building, learning</em>', kind: 'writing', date: 'ongoing' },
  { n: '07', img: 'flags',  href: '/flags',   title: 'flags.exe — <em>197 country flag quiz</em>', kind: 'project', date: 'windows 95 vibes' },
];
---

<div class="index-sec">
  <div class="index-header">
    <h2>[ index — the feed ]</h2>
    <span class="sub">// most recent first</span>
  </div>

  {items.map(item => (
    <a href={item.href} class="index-row reveal">
      <div class="rn">{item.n}</div>
      <div
        class={`rimg ${item.img}`}
        style={item.bg ? `background-image:url('${item.bg}');background-size:${item.bgFit || 'cover'};background-position:center;background-repeat:no-repeat;` : ''}
      >{item.symbol || ''}</div>
      <div class="rt" set:html={item.title} />
      <div class="rk">{item.kind}</div>
      <div class="rd">{item.date}</div>
      <div class="ra">→</div>
    </a>
  ))}
</div>

<style>
  .index-sec{padding:120px 32px;max-width:1400px;margin:0 auto;}
  .index-header{
    display:flex;justify-content:space-between;align-items:baseline;
    border-bottom:1px solid var(--text);padding-bottom:20px;margin-bottom:20px;
  }
  .index-header h2{
    font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:500;
    letter-spacing:.05em;text-transform:uppercase;
  }
  .index-header .sub{
    font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);
  }

  .index-row{
    display:grid;grid-template-columns:60px 80px 1fr 160px 130px 60px;
    gap:20px;align-items:center;padding:16px 0;
    border-bottom:1px solid var(--line);cursor:pointer;
    transition:background .25s,padding .25s;position:relative;
    text-decoration:none;color:var(--text);
  }
  .index-row:hover{background:var(--card);padding-left:12px;padding-right:12px;}
  .index-row::before{
    content:'';position:absolute;left:0;top:0;bottom:0;width:2px;
    background:var(--ember);transform:scaleY(0);transform-origin:top;
    transition:transform .3s ease;
  }
  .index-row:hover::before{transform:scaleY(1);}

  .rn{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);transition:color .2s;}
  .index-row:hover .rn{color:var(--ember);}
  .rimg{width:60px;height:60px;border-radius:2px;transition:all .4s;}
  .rimg.photos{background:linear-gradient(160deg,#3d5a5e,#0E6B6F);}
  .rimg.pups{background:linear-gradient(140deg,#E85D2F,#F2A93D);}
  .rimg.siviez{background:linear-gradient(200deg,#0E6B6F,#1E3A34);}
  .rimg.ariba{background:linear-gradient(140deg,#C8A35F,#8b6d3a);}
  .rimg.flags{background:linear-gradient(160deg,#008080,#1E3A34);}
  .rimg.bookmarks{
    background:linear-gradient(140deg,#C8A35F,#E85D2F);
    display:flex;align-items:center;justify-content:center;
    font-size:26px;color:#F4F0E8;
  }
  .rimg.text{
    background:var(--card);border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:22px;color:var(--muted);
  }
  .index-row:hover .rimg:not(.text){
    transform:scale(2.2) translateX(25%);z-index:5;position:relative;
    box-shadow:0 8px 30px rgba(24,33,30,.2);
  }
  .rt{font-size:19px;font-weight:500;letter-spacing:-.01em;line-height:1.3;}
  .rt :global(em){color:var(--accent);font-style:italic;font-weight:400;}
  .rk{
    font-family:'JetBrains Mono',monospace;font-size:11px;
    letter-spacing:.1em;text-transform:uppercase;color:var(--gold);
  }
  .rd{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted);text-align:right;}
  .ra{font-size:18px;color:var(--muted);text-align:right;transition:all .2s;}
  .index-row:hover .ra{color:var(--ember);transform:translateX(4px);}

  @media(max-width:800px){
    .index-sec{padding:80px 20px;}
    .index-row{grid-template-columns:30px 50px 1fr 40px;gap:10px;}
    .rk,.rd{display:none;}
    .rt{font-size:15px;}
    .index-row:hover .rimg:not(.text){transform:none;}
  }
</style>

<script>
  const obs = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach(e => obs.observe(e));
</script>
