---
---

<div class="contact-sec">
  <div class="contact-inner">
    <p class="kicker">// get in touch</p>
    <h2>Say <em>hello.</em></h2>
    <p class="lead">Reach out on Instagram or TikTok — that's where the real conversations happen.</p>
    <div class="contact-cta-group">
      <a href="https://instagram.com/pepijnvanhauwere" target="_blank" rel="noopener noreferrer" class="contact-cta">
        <span class="dot"></span>
        <span>Instagram · @pepijnvanhauwere</span>
        <span class="arr">→</span>
      </a>
      <a href="https://tiktok.com/@pups.jpg" target="_blank" rel="noopener noreferrer" class="contact-cta">
        <span class="dot"></span>
        <span>TikTok · @pups.jpg</span>
        <span class="arr">→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .contact-sec{
    background:var(--forest);color:#F4F0E8;padding:160px 32px;
    position:relative;overflow:hidden;
  }
  :global(html[data-mode="dark"]) .contact-sec{background:var(--card);color:var(--text);}
  .contact-sec::before{
    content:'';position:absolute;inset:0;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>");
    opacity:.09;mix-blend-mode:screen;pointer-events:none;
  }
  :global(html[data-mode="dark"]) .contact-sec::before{mix-blend-mode:multiply;opacity:.05;}

  .contact-inner{max-width:1400px;margin:0 auto;position:relative;z-index:1;}
  .contact-sec .kicker{
    font-family:'JetBrains Mono',monospace;font-size:12px;
    color:var(--ember);margin-bottom:32px;letter-spacing:.05em;text-transform:uppercase;
  }
  .contact-sec h2{
    font-size:clamp(48px,8vw,130px);font-weight:700;
    letter-spacing:-.045em;line-height:.95;margin-bottom:32px;
  }
  .contact-sec h2 em{color:var(--gold);font-style:italic;font-weight:400;}
  .contact-sec .lead{
    font-size:18px;line-height:1.7;color:rgba(244,240,232,.75);
    max-width:600px;margin-bottom:50px;
  }
  :global(html[data-mode="dark"]) .contact-sec .lead{color:var(--muted);}

  .contact-cta-group{display:flex;flex-direction:column;gap:14px;align-items:flex-start;}
  .contact-cta{
    display:inline-flex;align-items:center;gap:14px;
    font-family:'JetBrains Mono',monospace;font-size:14px;
    color:#F4F0E8;text-decoration:none;padding:14px 24px;
    border:1px solid rgba(244,240,232,.4);transition:all .3s;
  }
  :global(html[data-mode="dark"]) .contact-cta{color:var(--text);border-color:var(--line);}
  .contact-cta .dot{
    width:8px;height:8px;background:var(--ember);border-radius:50%;
    flex-shrink:0;transition:transform .3s;
  }
  .contact-cta .arr{
    margin-left:12px;transition:transform .3s;color:var(--ember);
  }
  .contact-cta:hover{
    background:var(--ember);color:#F4F0E8;border-color:var(--ember);
  }
  .contact-cta:hover .dot{background:#F4F0E8;transform:scale(1.5);}
  .contact-cta:hover .arr{color:#F4F0E8;transform:translateX(6px);}

  @media(max-width:800px){
    .contact-sec{padding:80px 20px;}
  }
</style>
