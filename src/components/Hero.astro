---
---

<div class="hero">
  <div class="hero-l">
    <p class="meta">
      // portfolio of <span>Puppy</span> — izegem, be<span class="late" id="late"> · working late again?</span>
    </p>
    <div class="type-wrap">
      <h1><span id="tw"></span><span class="cursor"></span></h1>
    </div>
  </div>
  <div class="hero-r">
    <a href="/jpg" class="hp hp1" data-tag="// dolomites, italy"></a>
    <a href="/siviez" class="hp hp2" data-tag="// siviez, valais"></a>
  </div>
</div>

<style>
  .hero{
    padding:140px 32px 60px;max-width:1400px;margin:0 auto;
    display:grid;grid-template-columns:1.4fr 1fr;gap:60px;align-items:end;
  }
  .hero-l .meta{
    font-family:'JetBrains Mono',monospace;font-size:12px;
    color:var(--muted);margin-bottom:32px;
  }
  .hero-l .meta span{color:var(--accent);}
  .hero-l .meta :global(.late){color:var(--ember);opacity:0;transition:opacity .3s;}
  .hero-l .meta :global(.late.show){opacity:1;}

  .type-wrap{
    min-height:calc(clamp(48px,8vw,130px) * 1.1);
    display:flex;align-items:flex-end;
  }
  .hero-l h1{
    font-size:clamp(48px,8vw,130px);font-weight:700;
    line-height:.92;letter-spacing:-.045em;
    animation:fadeIn 1s ease .2s both;
  }
  .hero-l h1 :global(.thin){font-weight:400;color:var(--muted);}
  .hero-l h1 :global(.accent){color:var(--accent);}
  .hero-l h1 :global(.ember){color:var(--ember);}
  .hero-l h1 .cursor{
    display:inline-block;width:6px;height:.8em;background:var(--ember);
    margin-left:6px;vertical-align:baseline;animation:blink 1.1s steps(2) infinite;
  }
  @keyframes blink{50%{opacity:0;}}
  @keyframes fadeIn{
    from{opacity:0;transform:translateY(15px);}
    to{opacity:1;transform:translateY(0);}
  }

  .hero-r{position:relative;height:400px;}
  .hp{position:absolute;border-radius:2px;overflow:hidden;box-shadow:0 8px 30px rgba(24,33,30,.15);display:block;background-size:cover;background-position:center;transition:transform .4s ease,box-shadow .4s ease;}
  .hp:hover{transform:translateY(-4px) scale(1.02);box-shadow:0 14px 40px rgba(24,33,30,.25);}
  .hp1{
    width:65%;height:75%;top:0;right:0;
    background-image:linear-gradient(to bottom,rgba(24,33,30,0) 40%,rgba(24,33,30,.55) 100%),url('/pupsjpg/italy-01-dolomites.jpg');
    animation:float1 8s ease-in-out infinite;
  }
  .hp2{
    width:50%;height:60%;bottom:0;left:0;
    background-image:linear-gradient(to bottom,rgba(24,33,30,0) 40%,rgba(24,33,30,.55) 100%),url('/pupsjpg/ch-03-resort.jpg');
    animation:float2 9s ease-in-out infinite;
  }
  @keyframes float1{0%,100%{transform:translate(0,0);}50%{transform:translate(-8px,6px);}}
  @keyframes float2{0%,100%{transform:translate(0,0);}50%{transform:translate(10px,-8px);}}
  .hp::after{
    content:attr(data-tag);position:absolute;bottom:10px;left:12px;
    font-family:'JetBrains Mono',monospace;font-size:10px;
    color:rgba(244,240,232,.85);letter-spacing:.1em;text-transform:uppercase;
  }

  @media(max-width:800px){
    .hero{padding:120px 20px 40px;grid-template-columns:1fr;gap:30px;}
    .hero-r{height:280px;}
  }
</style>

<script>
  interface Phrase { verb: string; word: string; cls: string; }

  const phrases: Phrase[] = [
    { verb: 'Sharing ', word: 'photos.', cls: 'accent' },
    { verb: 'Building ', word: 'caps.', cls: 'ember' },
    { verb: 'Sharing ', word: 'poems.', cls: 'accent' },
    { verb: 'Building ', word: 'sites.', cls: 'ember' },
    { verb: 'Sharing ', word: 'half-thoughts.', cls: 'accent' },
    { verb: 'Building ', word: 'with AI.', cls: 'ember' }
  ];

  const el = document.getElementById('tw');
  let pi = 0, phase = 0, ci = 0;

  function render(p: Phrase, fullLen: number) {
    if (!el) return;
    const pre = p.verb.slice(0, Math.min(p.verb.length, fullLen));
    let word = '';
    if (fullLen > p.verb.length) {
      word = p.word.slice(0, Math.min(p.word.length, fullLen - p.verb.length));
    }
    el.innerHTML = pre + '<span class="' + p.cls + '">' + word + '</span>';
  }

  function tick() {
    const p = phrases[pi];
    const total = p.verb.length + p.word.length;
    if (phase === 0) {
      ci++;
      if (ci >= total) { phase = 1; setTimeout(tick, 1800); return; }
    } else {
      ci -= 2;
      if (ci <= 0) { ci = 0; phase = 0; pi = (pi + 1) % phrases.length; setTimeout(tick, 300); return; }
    }
    render(p, ci);
    setTimeout(tick, phase === 0 ? 70 : 35);
  }
  tick();

  // Late-night easter egg
  const h = new Date().getHours();
  if (h >= 21 || h < 6) {
    document.getElementById('late')?.classList.add('show');
  }
</script>
