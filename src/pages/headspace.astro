---
import Layout from '../layouts/Layout.astro';
import postsData from '../data/headspace-posts.json';
const posts = postsData.posts;
---

<Layout title="Headspace · PUPVANH" description="De plek in mijn hoofd waar het gebeurt. Ideeën, gedachten en leercurves terwijl ik bouw aan PUPVANH.">

<div class="headspace-page">
  <div class="hs-wrap">

    <div class="hs-topbar">
      <a href="/">← <span data-i18n="back">pupvanh</span></a>
      <div class="right">
        <button class="toggle-btn" id="hsModeToggle" aria-label="Toggle light/dark mode">◐</button>
        <span class="lang">
          <span data-lang="nl">NL</span><span class="sep">·</span><span data-lang="en">EN</span>
        </span>
      </div>
    </div>

    <div class="hs-hero">
      <div class="kicker" data-i18n="kicker">/headspace · vol.01</div>
      <h1 data-i18n="title">Headspace.</h1>
      <p data-i18n="tagline">De plek in mijn hoofd waar het gebeurt. Ideeën, gedachten en leercurves terwijl ik bouw aan PUPVANH en side-projects. Ruw, onderweg, hardop.</p>
    </div>

    <div class="hs-filters">
      <span class="hs-tag active" data-filter="all" data-i18n="filter_all">alles</span>
      <span class="hs-tag" data-filter="ranting">ranting</span>
      <span class="hs-tag" data-filter="building">building</span>
      <span class="hs-tag" data-filter="learning">learning</span>
      <span class="hs-tag" data-filter="poems">poems</span>
      <span class="hs-count" id="hsCount">6 thoughts</span>
    </div>

    <div class="hs-list" id="hsList"></div>

    <div class="hs-footer">
      <div class="footer-block">
        <div class="footer-meta">BUILT AUG 2026 · UPDATED AUG 2026</div>
        <div class="footer-name">HEADSPACE</div>
        <div class="footer-part" data-i18n="footer_part">Deel van PUPVANH Projects</div>
        <a href="https://pupvanh.vercel.app" class="footer-link">→ pupvanh.vercel.app</a>
      </div>
      <a href="#" class="rss">rss →</a>
    </div>

  </div>
</div>

<style is:global>
/* ============ GLOBAL OVERRIDES als headspace-page in body zit ============ */
body:has(.headspace-page) { background: #DDE3E8; }
html[data-mode="dark"] body:has(.headspace-page) { background: #1E2A3A; }
body:has(.headspace-page) .grain { display: none; }

/* ============ SCOPED headspace styling ============ */
.headspace-page * { box-sizing: border-box; }
.headspace-page {
  font-family: 'Inter', sans-serif;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  background: #DDE3E8;
  color: #1E3A34;
  transition: background 0.35s ease, color 0.35s ease;
}
html[data-mode="dark"] .headspace-page { background: #1E2A3A; color: #E8E4D8; }

/* ============ THEME: light (graph blue) ============ */
.headspace-page .hs-topbar { border-color: rgba(30,58,52,0.1); }
.headspace-page .hs-topbar a,
.headspace-page .lang-active { color: #3B4E6B; }
.headspace-page .lang-inactive,
.headspace-page .toggle-btn { color: #6a7580; }
.headspace-page .hs-hero .kicker { color: #3B4E6B; }
.headspace-page .hs-hero h1 { color: #1E3A34; }
.headspace-page .hs-hero p { color: #3a4a5a; }
.headspace-page .hs-filters { background: rgba(255,255,255,0.4); border-color: rgba(30,58,52,0.08); }
.headspace-page .hs-tag { border-color: rgba(30,58,52,0.18); color: #4a5a68; }
.headspace-page .hs-tag.active { background: #3B4E6B; color: #DDE3E8; border-color: #3B4E6B; }
.headspace-page .hs-count { color: #6a7580; }
.headspace-page .hs-post { border-color: rgba(30,58,52,0.12); }
.headspace-page .hs-num { color: #3B4E6B; }
.headspace-page .hs-post h2 { color: #1E3A34; }
.headspace-page .hs-post .snip { color: #4a5a68; }
.headspace-page .hs-post .row,
.headspace-page .hs-post .date { color: #6a7580; }
.headspace-page .hs-post .pill { background: rgba(59,78,107,0.12); color: #3B4E6B; }
.headspace-page .hs-footer { border-color: rgba(30,58,52,0.1); color: #6a7580; }
.headspace-page .hs-footer a { color: #3B4E6B; }
.headspace-page .footer-name { color: #1E3A34; }
.headspace-page .footer-part { color: #3a4a5a; }

/* ============ THEME: dark (midnight) ============ */
html[data-mode="dark"] .headspace-page .hs-topbar { border-color: rgba(232,228,216,0.1); }
html[data-mode="dark"] .headspace-page .hs-topbar a,
html[data-mode="dark"] .headspace-page .lang-active { color: #8AA3C4; }
html[data-mode="dark"] .headspace-page .lang-inactive,
html[data-mode="dark"] .headspace-page .toggle-btn { color: #8a9aad; }
html[data-mode="dark"] .headspace-page .hs-hero .kicker { color: #8AA3C4; }
html[data-mode="dark"] .headspace-page .hs-hero h1 { color: #E8E4D8; }
html[data-mode="dark"] .headspace-page .hs-hero p { color: #B8B4A8; }
html[data-mode="dark"] .headspace-page .hs-filters { background: rgba(0,0,0,0.15); border-color: rgba(232,228,216,0.08); }
html[data-mode="dark"] .headspace-page .hs-tag { border-color: rgba(232,228,216,0.15); color: #B8B4A8; }
html[data-mode="dark"] .headspace-page .hs-tag.active { background: #8AA3C4; color: #1E2A3A; border-color: #8AA3C4; }
html[data-mode="dark"] .headspace-page .hs-count { color: #8a9aad; }
html[data-mode="dark"] .headspace-page .hs-post { border-color: rgba(232,228,216,0.12); }
html[data-mode="dark"] .headspace-page .hs-num { color: #8AA3C4; }
html[data-mode="dark"] .headspace-page .hs-post h2 { color: #E8E4D8; }
html[data-mode="dark"] .headspace-page .hs-post .snip { color: #B8B4A8; }
html[data-mode="dark"] .headspace-page .hs-post .row,
html[data-mode="dark"] .headspace-page .hs-post .date { color: #8a9aad; }
html[data-mode="dark"] .headspace-page .hs-post .pill { background: rgba(138,163,196,0.18); color: #8AA3C4; }
html[data-mode="dark"] .headspace-page .hs-footer { border-color: rgba(232,228,216,0.1); color: #8a9aad; }
html[data-mode="dark"] .headspace-page .hs-footer a { color: #8AA3C4; }
html[data-mode="dark"] .headspace-page .footer-name { color: #E8E4D8; }
html[data-mode="dark"] .headspace-page .footer-part { color: #B8B4A8; }

/* ============ LAYOUT ============ */
.headspace-page .hs-wrap { max-width: 780px; margin: 0 auto; padding: 0 28px; }

.headspace-page .hs-topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 0; border-bottom: 1px solid;
  font-family: 'JetBrains Mono', monospace; font-size: 11px;
  letter-spacing: 0.12em; text-transform: uppercase;
}
.headspace-page .hs-topbar a { text-decoration: none; }
.headspace-page .hs-topbar .right { display: flex; gap: 18px; align-items: center; }
.headspace-page .toggle-btn {
  background: none; border: none; font-family: inherit; font-size: 14px;
  cursor: pointer; padding: 4px 6px; letter-spacing: 0.1em;
  transition: opacity 0.2s;
}
.headspace-page .toggle-btn:hover { opacity: 0.6; }
.headspace-page .lang [data-lang] { cursor: pointer; transition: opacity 0.2s; padding: 2px 3px; }
.headspace-page .lang [data-lang]:hover { opacity: 0.7; }
.headspace-page .lang-inactive { opacity: 0.45; }
.headspace-page .lang-active { font-weight: 600; opacity: 1; }
.headspace-page .lang .sep { opacity: 0.35; margin: 0 2px; }

.headspace-page .hs-hero { padding: 72px 0 48px; }
.headspace-page .hs-hero .kicker {
  font-family: 'JetBrains Mono', monospace; font-size: 11px;
  letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 16px;
}
.headspace-page .hs-hero h1 {
  font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500;
  font-size: 68px; line-height: 1; margin: 0 0 22px; letter-spacing: -0.015em;
}
.headspace-page .hs-hero p { font-size: 16px; line-height: 1.7; margin: 0; max-width: 540px; }

.headspace-page .hs-filters {
  display: flex; gap: 8px; padding: 16px 28px; margin: 0 -28px;
  flex-wrap: wrap; border-top: 1px solid; border-bottom: 1px solid;
  align-items: center;
}
.headspace-page .hs-tag {
  font-family: 'JetBrains Mono', monospace; font-size: 11px;
  padding: 6px 14px; border-radius: 20px; border: 1px solid;
  letter-spacing: 0.06em; cursor: pointer;
  transition: background 0.2s, color 0.2s, transform 0.15s;
  background: transparent; user-select: none;
}
.headspace-page .hs-tag:hover { transform: translateY(-1px); }
.headspace-page .hs-count {
  margin-left: auto; font-family: 'JetBrains Mono', monospace;
  font-size: 11px; letter-spacing: 0.08em;
}

.headspace-page .hs-list { padding: 8px 0 48px; }
.headspace-page .hs-post {
  display: grid; grid-template-columns: 70px 1fr auto; gap: 24px;
  padding: 30px 0; border-bottom: 1px solid; align-items: baseline;
  cursor: pointer; transition: transform 0.25s ease;
}
.headspace-page .hs-post:hover { transform: translateX(4px); }
.headspace-page .hs-post:last-child { border-bottom: none; }
.headspace-page .hs-num { font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; padding-top: 8px; }
.headspace-page .hs-post h2 {
  font-family: 'Playfair Display', serif; font-style: italic;
  font-weight: 400; font-size: 26px; margin: 0 0 10px; line-height: 1.2;
}
.headspace-page .hs-post .snip { font-size: 14px; line-height: 1.6; margin: 0 0 14px; }
.headspace-page .hs-post .row {
  display: flex; gap: 10px; font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
  align-items: center; flex-wrap: wrap;
}
.headspace-page .hs-post .pill { padding: 3px 9px; border-radius: 10px; }
.headspace-page .hs-post .date {
  font-family: 'JetBrains Mono', monospace; font-size: 11px;
  text-align: right; padding-top: 8px; white-space: nowrap; line-height: 1.4;
}

/* ============ FOOTER ============ */
.headspace-page .hs-footer {
  padding: 32px 0 40px; border-top: 1px solid;
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 24px; flex-wrap: wrap;
}
.headspace-page .footer-block {
  font-family: 'JetBrains Mono', monospace; font-size: 10px;
  letter-spacing: 0.12em; text-transform: uppercase;
  line-height: 1.9;
}
.headspace-page .footer-meta { opacity: 0.75; }
.headspace-page .footer-name { font-weight: 600; letter-spacing: 0.15em; }
.headspace-page .footer-part { opacity: 0.9; }
.headspace-page .footer-link {
  text-decoration: none; display: inline-block; margin-top: 4px;
  transition: opacity 0.2s;
}
.headspace-page .footer-link:hover { opacity: 0.7; }
.headspace-page .hs-footer .rss {
  font-family: 'JetBrains Mono', monospace; font-size: 10px;
  letter-spacing: 0.12em; text-transform: uppercase;
  text-decoration: none; padding-top: 4px;
  transition: opacity 0.2s;
}
.headspace-page .hs-footer .rss:hover { opacity: 0.7; }

/* ============ MOBILE ============ */
@media (max-width: 640px) {
  .headspace-page .hs-wrap { padding: 0 18px; }
  .headspace-page .hs-hero { padding: 48px 0 32px; }
  .headspace-page .hs-hero h1 { font-size: 46px; }
  .headspace-page .hs-hero p { font-size: 15px; }
  .headspace-page .hs-filters { padding: 14px 18px; margin: 0 -18px; }
  .headspace-page .hs-post { grid-template-columns: 44px 1fr; gap: 14px; padding: 24px 0; }
  .headspace-page .hs-post h2 { font-size: 22px; }
  .headspace-page .hs-post .date { grid-column: 2; padding-top: 4px; text-align: left; }
  .headspace-page .hs-num { padding-top: 6px; }
}
</style>

<script define:vars={{ postsData: posts }}>
const i18n = {
  nl: {
    back: 'pupvanh',
    kicker: '/headspace · vol.01',
    title: 'Headspace.',
    tagline: 'De plek in mijn hoofd waar het gebeurt. Ideeën, gedachten en leercurves terwijl ik bouw aan PUPVANH en side-projects. Ruw, onderweg, hardop.',
    filter_all: 'alles',
    countSuffix: (n) => n === 1 ? ' thought' : ' thoughts',
    footer_part: 'Deel van PUPVANH Projects'
  },
  en: {
    back: 'pupvanh',
    kicker: '/headspace · vol.01',
    title: 'Headspace.',
    tagline: 'The place in my head where it happens. Ideas, thoughts and learning curves while I build PUPVANH and side projects. Raw, in progress, out loud.',
    filter_all: 'all',
    countSuffix: (n) => n === 1 ? ' thought' : ' thoughts',
    footer_part: 'Part of PUPVANH Projects'
  }
};

const posts = postsData;
let currentLang = 'nl';
let currentFilter = 'all';

function renderPosts() {
  const list = document.getElementById('hsList');
  const filtered = currentFilter === 'all' ? posts : posts.filter(p => p.tags.includes(currentFilter));

  list.innerHTML = filtered.map(p => `
    <div class="hs-post">
      <div class="hs-num">#${p.num}</div>
      <div>
        <h2>${p['title_' + currentLang]}</h2>
        <p class="snip">${p['snip_' + currentLang]}</p>
        <div class="row">
          ${p.tags.map(t => `<span class="pill">${t}</span>`).join('')}
          <span>${p.readTime} min</span>
        </div>
      </div>
      <div class="date">${p['date_' + currentLang]}</div>
    </div>
  `).join('');

  document.getElementById('hsCount').textContent = filtered.length + i18n[currentLang].countSuffix(filtered.length);
}

function applyLang(lang) {
  currentLang = lang;
  document.documentElement.lang = lang;
  localStorage.setItem('headspace-lang', lang);

  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (i18n[lang][key]) el.textContent = i18n[lang][key];
  });

  document.querySelectorAll('[data-lang]').forEach(el => {
    const active = el.getAttribute('data-lang') === lang;
    el.classList.toggle('lang-active', active);
    el.classList.toggle('lang-inactive', !active);
  });

  renderPosts();
}

function applyMode(mode) {
  document.documentElement.setAttribute('data-mode', mode);
  localStorage.setItem('headspace-mode', mode);
  const btn = document.getElementById('hsModeToggle');
  if (btn) btn.textContent = mode === 'dark' ? '◑' : '◐';
}

const savedLang = localStorage.getItem('headspace-lang');
const browserLang = navigator.language.toLowerCase().startsWith('en') ? 'en' : 'nl';
applyLang(savedLang || browserLang);

const savedMode = localStorage.getItem('headspace-mode');
const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
applyMode(savedMode || (prefersDark ? 'dark' : 'light'));

document.querySelectorAll('[data-lang]').forEach(el => {
  el.addEventListener('click', () => applyLang(el.getAttribute('data-lang')));
});

const modeToggle = document.getElementById('hsModeToggle');
if (modeToggle) {
  modeToggle.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-mode');
    applyMode(current === 'dark' ? 'light' : 'dark');
  });
}

document.querySelectorAll('.hs-tag').forEach(tag => {
  tag.addEventListener('click', () => {
    document.querySelectorAll('.hs-tag').forEach(t => t.classList.remove('active'));
    tag.classList.add('active');
    currentFilter = tag.getAttribute('data-filter');
    renderPosts();
  });
});
</script>

</Layout>
