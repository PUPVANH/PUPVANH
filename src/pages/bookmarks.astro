---
import Analytics from '@vercel/analytics/astro';
import bookmarksData from '../data/bookmarks.json';
const bookmarks = bookmarksData.bookmarks;

// Filter-tellingen automatisch uit de data
const themeCounts = {};
bookmarks.forEach(b => { themeCounts[b.theme] = (themeCounts[b.theme] || 0) + 1; });
const themeOrder = ['places', 'spoken word', 'tattoo artist', 'photography', 'music'];
const themes = themeOrder.filter(t => themeCounts[t]);
---
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Bookmarks · PUPVANH</title>
<meta name="description" content="People, places, poems, sites and artists that got to me. No affiliates, no ads — just things worth your click." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --teal: #0E6B6F;
    --gold: #C8A35F;
    --ember: #E85D2F;
    --ivory: #F4F0E8;
    --forest: #1E3A34;
    --mute: #7a8580;
    --bg: var(--ivory);
    --text: var(--forest);
    --card: #ffffff;
    --line: rgba(30, 58, 52, 0.10);
    --photo-bg: linear-gradient(135deg, #E8DFCF 0%, #DED2BC 100%);
  }
  html[data-mode="dark"] {
    --bg: #14201C;
    --text: #E8E4D7;
    --card: #1B2A25;
    --line: rgba(232, 228, 215, 0.10);
    --mute: #8a958f;
    --photo-bg: linear-gradient(135deg, #2A3A35 0%, #1F2C28 100%);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: var(--bg); color: var(--text); }
  body {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.35;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.12 0 0 0 0 0.23 0 0 0 0 0.20 0 0 0 0.22 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    mix-blend-mode: multiply;
  }

  .topbar {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .back-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--mute);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.25s, transform 0.25s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .back-link:hover { color: var(--ember); transform: translateX(-3px); }
  .mini-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .mini-nav a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--mute);
    text-decoration: none;
    text-transform: lowercase;
    transition: color 0.25s ease;
  }
  .mini-nav a:hover { color: var(--ember); }
  .mode-toggle {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    width: 32px; height: 32px;
    cursor: pointer;
    color: var(--text);
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .mode-toggle:hover { border-color: var(--ember); color: var(--ember); }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 32px 100px;
    position: relative;
    z-index: 2;
  }
  .hero {
    margin-bottom: 90px;
    max-width: 720px;
  }
  .kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember);
    margin-bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .kicker::before {
    content: '';
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ember);
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: clamp(56px, 9vw, 108px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--forest);
    margin-bottom: 28px;
  }
  html[data-mode="dark"] .hero h1 { color: var(--ivory); }
  .hero h1 em {
    font-style: italic;
    color: var(--teal);
  }
  html[data-mode="dark"] .hero h1 em { color: var(--gold); }
  .hero p.intro {
    font-size: 19px;
    line-height: 1.55;
    color: var(--mute);
    max-width: 580px;
    font-weight: 400;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .filter-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
    background: transparent;
    border: 1px solid var(--line);
    padding: 9px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .filter-pill:hover {
    border-color: color-mix(in srgb, var(--ember) 50%, transparent);
    color: var(--text);
  }
  .filter-pill.active {
    background: var(--forest);
    color: var(--ivory);
    border-color: var(--forest);
  }
  html[data-mode="dark"] .filter-pill.active {
    background: var(--ember);
    color: var(--forest);
    border-color: var(--ember);
  }
  .filter-pill .count {
    opacity: 0.55;
    margin-left: 5px;
  }
  .card.hidden {
    display: none;
  }
  @media (max-width: 800px) {
    .filters { margin-bottom: 28px; }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; gap: 20px; }
    main { padding: 60px 22px 80px; }
    .topbar-inner { padding: 14px 22px; }
  }

  .card {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 42px 38px 36px;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 320px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s;
    overflow: hidden;
    font-family: inherit;
    text-align: left;
    width: 100%;
  }
  .card::before {
    content: '';
    position: absolute;
    left: 0; top: 0;
    width: 2px; height: 0;
    background: var(--ember);
    transition: height 0.35s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -20px rgba(30, 58, 52, 0.18);
    border-color: color-mix(in srgb, var(--forest) 20%, transparent);
  }
  .card:hover::before { height: 100%; }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }
  .card-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--mute);
    letter-spacing: 0.08em;
  }
  .badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .badge::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--ember);
  }
  .card-title {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 34px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--forest);
    margin: 4px 0 0;
  }
  html[data-mode="dark"] .card-title { color: var(--ivory); }
  .card-title em {
    font-style: italic;
    color: var(--teal);
  }
  html[data-mode="dark"] .card-title em { color: var(--gold); }
  .card-desc {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--mute);
    flex: 1;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px dashed var(--line);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--mute);
    letter-spacing: 0.04em;
  }
  .card-meta .url {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60%;
  }
  .visit-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--ember) 45%, transparent);
    padding: 8px 14px;
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
    z-index: 3;
    position: relative;
  }
  .visit-pill:hover {
    background: var(--ember);
    color: var(--ivory);
    border-color: var(--ember);
    transform: translateX(2px);
  }
  html[data-mode="dark"] .visit-pill:hover { color: var(--forest); }
  .visit-pill .arrow {
    font-size: 12px;
    transition: transform 0.25s ease;
  }
  .visit-pill:hover .arrow { transform: translateX(3px); }
  .card-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mute);
    opacity: 0.7;
    transition: opacity 0.25s, color 0.25s;
  }
  .card:hover .card-hint { opacity: 1; color: var(--forest); }
  html[data-mode="dark"] .card:hover .card-hint { color: var(--ivory); }
  .card-hint::before {
    content: '⤢';
    font-size: 13px;
  }

  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(30, 58, 52, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 100;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 60px 20px;
    overflow-y: auto;
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: var(--card);
    max-width: 720px;
    width: 100%;
    border-radius: 6px;
    padding: 56px 56px 44px;
    position: relative;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.4);
    animation: rise 0.35s ease;
    display: none;
    flex-direction: column;
  }
  .modal.active { display: flex; }
  @keyframes rise {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .modal-close {
    position: absolute;
    top: 20px; right: 20px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text);
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    z-index: 2;
  }
  .modal-close:hover { border-color: var(--ember); color: var(--ember); transform: rotate(90deg); }

  .modal-kicker {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
    margin-bottom: 16px;
  }
  .modal h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
    font-size: 46px;
    line-height: 1.05;
    color: var(--forest);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .modal h2 em { font-style: italic; color: var(--teal); }
  html[data-mode="dark"] .modal h2 { color: var(--ivory); }
  html[data-mode="dark"] .modal h2 em { color: var(--gold); }

  .modal-byline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--mute);
    letter-spacing: 0.05em;
    margin-bottom: 28px;
  }
  .modal-byline a { color: var(--teal); text-decoration: none; }
  html[data-mode="dark"] .modal-byline a { color: var(--gold); }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 36px;
  }
  .btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 11px 20px;
    border-radius: 999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s;
    border: 1px solid transparent;
  }
  .btn-primary {
    background: var(--forest);
    color: var(--ivory);
  }
  html[data-mode="dark"] .btn-primary {
    background: var(--ember);
    color: var(--forest);
  }
  .btn-primary:hover {
    background: var(--ember);
    color: var(--ivory);
    transform: translateY(-2px);
  }
  html[data-mode="dark"] .btn-primary:hover {
    background: var(--gold);
    color: var(--forest);
  }
  .btn-secondary {
    background: transparent;
    color: var(--text);
    border-color: var(--line);
  }
  .btn-secondary:hover {
    border-color: var(--ember);
    color: var(--ember);
    transform: translateY(-2px);
  }
  .btn .ext {
    display: inline-block;
    margin-left: 4px;
    transition: transform 0.25s ease;
  }
  .btn:hover .ext {
    transform: translate(2px, -2px);
  }

  .content-block { margin-bottom: 32px; }
  .content-block:last-child { margin-bottom: 0; }
  .content-block h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 18px;
  }
  .content-block p {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text);
    margin-bottom: 14px;
  }
  .content-block p:last-child { margin-bottom: 0; }

  .poem {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    line-height: 1.75;
    color: var(--text);
  }
  .poem p { margin-bottom: 22px; }
  .poem p:first-child::first-letter {
    font-size: 56px;
    line-height: 0.9;
    float: left;
    margin: 6px 12px 0 0;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: var(--ember);
  }

  .photo-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }
  .photo-strip .photo { aspect-ratio: 3/4; }

  .photo-single {
    aspect-ratio: 1400/745;
    margin-bottom: 24px;
  }
  .photo-feed {
    aspect-ratio: 1/1;
    margin-bottom: 12px;
    max-width: 480px;
  }
  .photo-duo {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }
  .photo-duo .photo { aspect-ratio: 3/4; }
  .photo-triple {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }
  .photo-triple .photo { aspect-ratio: 4/3; }

  .photo {
    background: var(--photo-bg);
    border: 1px dashed color-mix(in srgb, var(--ember) 40%, transparent);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 12px;
  }
  .photo:has(img) {
    border: none;
    background: transparent;
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 4px;
    display: block;
  }
  .photo:not(:has(img))::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='60' height='60'><circle cx='30' cy='30' r='0.5' fill='%230E6B6F' opacity='0.3'/></svg>");
    background-size: 20px 20px;
    opacity: 0.4;
  }
  .photo:not(:has(img))::after {
    content: '◇';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 32px;
    color: color-mix(in srgb, var(--forest) 20%, transparent);
  }
  .photo .cap {
    position: relative;
    z-index: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--forest);
    text-transform: uppercase;
    background: var(--ivory);
    padding: 4px 8px;
    border-radius: 2px;
    opacity: 0.9;
  }
  html[data-mode="dark"] .photo .cap {
    background: var(--forest);
    color: var(--ivory);
  }

  .quote-block {
    background: color-mix(in srgb, var(--ember) 8%, transparent);
    border-left: 3px solid var(--ember);
    padding: 22px 26px;
    margin: 24px 0;
    border-radius: 0 4px 4px 0;
  }
  .quote-block p {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 8px;
  }
  .quote-block cite {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
    font-style: normal;
  }

  .poem-excerpt {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 20px;
    line-height: 1.6;
    color: var(--text);
    padding: 24px 0;
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }
  .poem-excerpt .attribution {
    display: block;
    margin-top: 18px;
    font-family: 'JetBrains Mono', monospace;
    font-style: normal;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .modal-footer-note {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: right;
  }

  @media (max-width: 640px) {
    .modal { padding: 40px 24px 32px; }
    .modal h2 { font-size: 32px; }
    .poem, .content-block p { font-size: 16px; }
    .modal-overlay { padding: 20px 12px; }
    .photo-triple, .photo-strip, .photo-duo { grid-template-columns: 1fr; }
  }

  footer.pupvanh-footer {
    background: var(--forest);
    color: var(--ivory);
    padding: 26px 32px;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    position: relative;
    z-index: 2;
  }
  .pupvanh-footer .row1 { margin-bottom: 8px; opacity: 0.9; }
  .pupvanh-footer .row2 { opacity: 0.75; }
  .pupvanh-footer .sep { color: var(--ember); margin: 0 10px; font-weight: bold; }
  .pupvanh-footer a {
    color: var(--ivory);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .pupvanh-footer a:hover { border-color: var(--ember); }
</style>
</head>
<body class="bookmarks-page">

<div class="topbar">
  <div class="topbar-inner">
    <nav class="mini-nav" aria-label="Site navigation">
      <a href="/">home</a>
      <a href="/notes">notes</a>
      <a href="/jpg">jpg</a>
    </nav>
    <button class="mode-toggle" id="modeToggle" aria-label="Toggle mode">◐</button>
  </div>
</div>

<main>
  <section class="hero">
    <div class="kicker">bookmarks</div>
    <h1>Worth your <em>click.</em></h1>
    <p class="intro">People, places, poems, sites and artists that got to me. No affiliates, no ads — just things worth your click.</p>
  </section>

  <nav class="filters" id="filters" aria-label="Filter bookmarks by theme">
    <button class="filter-pill active" data-filter="all">all<span class="count">{bookmarks.length}</span></button>
    {themes.map(theme => (
      <button class="filter-pill" data-filter={theme}>{theme}<span class="count">{themeCounts[theme]}</span></button>
    ))}
  </nav>

  <section class="grid" id="grid">
    {bookmarks.map(b => (
      <div class="card" data-modal={b.num} data-theme={b.theme} role="button" tabindex="0">
        <div class="card-head">
          <span class="card-num">{b.num}</span>
          <span class="badge">{b.badge}</span>
        </div>
        <h3 class="card-title" set:html={b.title + '<em>' + b.titleEm + '</em>'}></h3>
        <p class="card-desc">{b.cardDesc}</p>
        <div class="card-meta">
          <span class="card-hint">{b.cardHint}</span>
          <a class="visit-pill" href={b.visit.href} target="_blank" rel="noopener" data-nomodal>
            {b.visit.label} <span class="arrow">↗</span>
          </a>
        </div>
      </div>
    ))}
  </section>
</main>

<div class="modal-overlay" id="modal-overlay">
  {bookmarks.map(b => (
    <div class="modal" data-id={b.num}>
      <button class="modal-close">✕</button>
      <div class="modal-kicker">{b.modalKicker}</div>
      <h2 set:html={b.title + '<em>' + b.titleEm + '</em>'}></h2>
      <div class="modal-byline" set:html={b.byline}></div>

      <div class="actions">
        {b.actions.map(a => (
          <a class={a.primary ? 'btn btn-primary' : 'btn btn-secondary'} href={a.href} target="_blank" rel="noopener">
            {a.label} <span class="ext">↗</span>
          </a>
        ))}
      </div>

      {b.blocks.map(block => (
        <>
          {block.type === 'text' && (
            <div class="content-block">
              <h3>{block.h3}</h3>
              {block.paragraphs.map(p => (<p>{p}</p>))}
            </div>
          )}
          {block.type === 'poem' && (
            <div class="content-block">
              <h3>{block.h3}</h3>
              <div class="poem">
                {block.paragraphs.map(p => (<p>{p}</p>))}
              </div>
            </div>
          )}
          {block.type === 'photos' && (
            <div class="content-block">
              <h3>{block.h3}</h3>
              {(block.layout === 'single' || block.layout === 'feed') ? (
                <div class={block.layout === 'single' ? 'photo photo-single' : 'photo photo-feed'}>
                  <img src={block.items[0].src} alt={block.items[0].alt} />
                  <span class="cap">{block.items[0].cap}</span>
                </div>
              ) : (
                <div class={block.layout === 'strip' ? 'photo-strip' : block.layout === 'duo' ? 'photo-duo' : 'photo-triple'}>
                  {block.items.map(item => (
                    <div class="photo"><img src={item.src} alt={item.alt} /><span class="cap">{item.cap}</span></div>
                  ))}
                </div>
              )}
            </div>
          )}
          {block.type === 'quote' && (
            <div class="quote-block">
              <p>{'"' + block.text + '"'}</p>
              <cite>{block.cite}</cite>
            </div>
          )}
          {block.type === 'poemExcerpt' && (
            <div class="poem-excerpt" set:html={block.text + '<span class="attribution">' + block.attribution + '</span>'}></div>
          )}
        </>
      ))}

      <div class="modal-footer-note">{b.footerNote}</div>
    </div>
  ))}
</div>

<footer class="pupvanh-footer">
  <div class="row1">© 2026 PUPVANH Projects <span class="sep">•</span> all rights reserved</div>
  <div class="row2">BUILT AUG 2026 <span class="sep">•</span> UPDATED SEP 2026 <span class="sep">•</span> Bookmarks <span class="sep">•</span> <a href="https://www.pupvanh.com">pupvanh.com →</a></div>
</footer>

<Analytics />

<script>
  const filterPills = document.querySelectorAll('.filter-pill');
  const allCards = document.querySelectorAll('.card');
  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter;
      filterPills.forEach(p => p.classList.toggle('active', p === pill));
      allCards.forEach(card => {
        const show = filter === 'all' || card.dataset.theme === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });

  const overlay = document.getElementById('modal-overlay');
  const modals = document.querySelectorAll('.modal');

  function openModal(id) {
    modals.forEach(m => m.classList.toggle('active', m.dataset.id === String(id)));
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    const active = document.querySelector('.modal.active');
    if (active) active.scrollTop = 0;
    overlay.scrollTop = 0;
  }
  function closeModal() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    setTimeout(() => modals.forEach(m => m.classList.remove('active')), 200);
  }

  document.querySelectorAll('[data-modal]').forEach(el => {
    el.addEventListener('click', e => {
      if (e.target.closest('[data-nomodal]')) return;
      openModal(el.dataset.modal);
    });
    el.addEventListener('keydown', e => {
      if ((e.key === 'Enter' || e.key === ' ') && !e.target.closest('[data-nomodal]')) {
        e.preventDefault();
        openModal(el.dataset.modal);
      }
    });
  });
  document.querySelectorAll('[data-nomodal]').forEach(el => {
    el.addEventListener('click', e => e.stopPropagation());
  });
  document.querySelectorAll('.modal-close').forEach(btn => btn.addEventListener('click', closeModal));
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  const modeToggle = document.getElementById('modeToggle');
  const savedMode = localStorage.getItem('bookmarks-mode') || 'light';
  document.documentElement.dataset.mode = savedMode;
  modeToggle.textContent = savedMode === 'dark' ? '◑' : '◐';
  modeToggle.addEventListener('click', () => {
    const next = document.documentElement.dataset.mode === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.mode = next;
    modeToggle.textContent = next === 'dark' ? '◑' : '◐';
    localStorage.setItem('bookmarks-mode', next);
  });
</script>

</body>
</html>
