---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Counters from '../components/Counters.astro';
import FeaturedSplit from '../components/FeaturedSplit.astro';
import FeedIndex from '../components/FeedIndex.astro';
import WordMarquee from '../components/WordMarquee.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import PupvanhFooter from '../components/PupvanhFooter.astro';
---

<Layout
  title="Puppy's creative hub: website projects, photography, merch & more"
  description="A personal creative hub by Puppy — learning to build with AI. Website projects, travel photography on a Fujifilm X100F, Pups merch, FC Ariba and more."
  favicon="/favicons/homepage.svg"
  canonicalPath="/"
>
  <Nav />
  <Hero />
  <Counters />
  <FeaturedSplit />
  <FeedIndex />
  <WordMarquee />
  <AboutSection />
  <ContactSection />

  <PupvanhFooter
    paginaNaam="Home"
    built="AUG 2026"
    updated="AUG 2026"
    theme="default"
    socials={[
      { label: 'INSTAGRAM', href: 'https://instagram.com/pepijnvanhauwere' },
      { label: 'TIKTOK', href: 'https://tiktok.com/@pups.jpg' },
    ]}
  />
</Layout>
