<script is:inline define:vars={{ photos: photosClient }}>
  // Dark/light met localStorage
  const saved = localStorage.getItem('pupsjpg-mode');
  if (saved) document.documentElement.dataset.mode = saved;
  document.querySelector('[data-toggle]').addEventListener('click', () => {
    const html = document.documentElement;
    html.dataset.mode = html.dataset.mode === 'dark' ? 'light' : 'dark';
    localStorage.setItem('pupsjpg-mode', html.dataset.mode);
  });

  // Filter chips
  function applyFilter(f) {
    document.querySelectorAll('.chip').forEach(c => c.classList.remove('on'));
    document.querySelector(`.chip[data-filter="${f}"]`)?.classList.add('on');
    document.querySelectorAll('.photo').forEach(p => {
      if (f === 'all' || p.dataset.place === f) p.classList.remove('hidden');
      else p.classList.add('hidden');
    });
  }
  document.querySelectorAll('.chip').forEach(chip => {
    chip.addEventListener('click', () => applyFilter(chip.dataset.filter));
  });

  // Lightbox
  let cur = 0;
  function openLb(i) {
    cur = i; renderLb();
    document.getElementById('lb').classList.add('on');
    document.body.style.overflow = 'hidden';
  }
  function closeLb() {
    document.getElementById('lb').classList.remove('on');
    document.body.style.overflow = '';
  }
  function prevLb() { cur = (cur - 1 + photos.length) % photos.length; renderLb(); }
  function nextLb() { cur = (cur + 1) % photos.length; renderLb(); }
  function renderLb() {
    const p = photos[cur];
    document.getElementById('lb-img').src = p.src;
    document.getElementById('lb-t').textContent = p.title;
    document.getElementById('lb-m').textContent = p.loc + ' · ' + p.date + '  ·  ' + (cur+1) + ' / ' + photos.length;
  }
  document.querySelectorAll('.photo').forEach(el => {
    el.addEventListener('click', () => openLb(parseInt(el.dataset.idx)));
  });
  document.querySelector('[data-lb-close]').addEventListener('click', closeLb);
  document.querySelector('[data-lb-prev]').addEventListener('click', prevLb);
  document.querySelector('[data-lb-next]').addEventListener('click', nextLb);
  document.addEventListener('keydown', e => {
    if (!document.getElementById('lb').classList.contains('on')) return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowLeft') prevLb();
    if (e.key === 'ArrowRight') nextLb();
  });
</script>
