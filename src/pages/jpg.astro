  { file:'ch-06-cleuson-above.jpg',      size:'tall', place:'ch', title:'From the ridge',              loc:'Lac de Cleuson, Valais',   date:'06.2024' },
  { file:'ch-02-forest.jpg',             size:'tall', place:'ch', title:'Larches and last snow',        loc:'Siviez, Valais',           date:'06.2024' },
  { file:'ch-03-resort.jpg',             size:'tall', place:'ch', title:'The valley wakes',             loc:'Siviez, Valais',           date:'06.2024' },
  { file:'ch-07-cleuson-dam.jpg',        size:'tall', place:'ch', title:'The dam wall',                loc:'Lac de Cleuson, Valais',   date:'06.2024' },
  { file:'it-09-dolomites-moon.jpg',     size:'tall', place:'it', title:'Moon over the pass',           loc:'Alta Badia, Dolomites',    date:'06.2024' },
  { file:'it-10-lago-di-braies.jpg',     size:'tall', place:'it', title:'Wooden boats on a mirror',     loc:'Lago di Braies, Dolomites',date:'06.2024' },
  { file:'it-11-manarola-cliff.jpg',     size:'tall', place:'it', title:'Golden hour over the swim spot', loc:'Manarola, Cinque Terre', date:'06.2024' },
  { file:'ch-09-basel-rhine.jpg',        size:'wide', place:'ch', title:'The Münster from the Rhine',   loc:'Basel, Switzerland',       date:'06.2024' },
  { file:'ch-10-vevey-stranger.jpg',     size:'tall', place:'ch', title:'First shot with a stranger',   loc:'Vevey, Lake Geneva',       date:'06.2024' },
