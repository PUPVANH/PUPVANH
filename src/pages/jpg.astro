  { file:'bled-02-island.jpg',           size:'tall', place:'si', title:'The island alone',             loc:'Lake Bled, Slovenia',      date:'07.2024' },
  { file:'bled-03-loungers.jpg',         size:'tall', place:'si', title:'Loungers, late afternoon',     loc:'Lake Bled, Slovenia',      date:'07.2024' },
  { file:'ch-01-chapel.jpg',             size:'tall', place:'ch', title:'Chapel in the drizzle',        loc:'Siviez, Valais',           date:'06.2024' },
  { file:'ch-05-turquoise.jpg',          size:'tall', place:'ch', title:'Turquoise, held by snow',      loc:'Lac de Cleuson, Valais',   date:'06.2024' },
