const MONTHS = ['', 'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

// Lees ALLE foto's in src/photos/ in (bij build).
// query:'?url' geeft het definitieve pad naar elk bestand terug (geen Sharp nodig,
// dus geen build-risico op Vercel). De foto's worden 1-op-1 mee gedeployed.
const photoModules = import.meta.glob(
  '/src/photos/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP}',
  { eager: true, query: '?url', import: 'default' }
);

function parsePhoto(path, url) {
  // path is bv /src/photos/2024-06_ch_Siviez_Chapel-in-the-drizzle_tall.jpg
  const file = path.split('/').pop();                 // bestandsnaam
  const base = file.replace(/\.[^.]+$/, '');          // zonder extensie
  const parts = base.split('_');
  // Verwacht: [datum, land, stad, bijschrift, grootte]  (grootte optioneel)
  if (parts.length < 4) return null;                  // oude/foute naam → overslaan
  const [datePart, land, stad, bijschrift, groottePart] = parts;

  // Datum JJJJ-MM
  const dm = /^(\d{4})-(\d{2})$/.exec(datePart);
  if (!dm) return null;
  const year = dm[1];
  const monthNum = parseInt(dm[2], 10);
  if (monthNum < 1 || monthNum > 12) return null;     // ongeldige maand → overslaan
  const sortKey = year + dm[2];                       // "202406" voor sorteren
  const dateLabel = dm[2] + '.' + year;               // "06.2024" zoals voorheen

  // Land
  const landCode = (land || '').toLowerCase();

  // Titel: streepjes → spaties
  const title = (bijschrift || '').replace(/-/g, ' ');

  // Grootte: tall (default) / wide / sq
  let size = 'tall';
  if (groottePart) {
    const g = groottePart.toLowerCase();
    if (g === 'wide' || g === 'sq' || g === 'tall') size = g;
  }

  // Locatie-label: "Stad, Land"
  const countryLabel = COUNTRIES[landCode]?.label || landCode.toUpperCase();
  const loc = stad ? stad.replace(/-/g, ' ') + ', ' + countryLabel : countryLabel;

  return {
    src: url,                  // definitief pad naar het beeld
    file,
    size,
    place: landCode,
    title,
    loc,
    date: dateLabel,
    sortKey,
  };
}

// Alle foto's inlezen, ongeldige namen overslaan, sorteren nieuwste eerst
const photos = Object.entries(photoModules)
  .map(([path, url]) => parsePhoto(path, url))
  .filter(Boolean)
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey));

// Client-veilige versie voor de lightbox (identiek, maar expliciet los gehouden)
const photosClient = photos.map(p => ({
  src: p.src,
  title: p.title,
  loc: p.loc,
  date: p.date,
  place: p.place,
}));

// Filters automatisch opbouwen uit de landen die echt voorkomen
const presentCountries = [...new Set(photos.map(p => p.place))];
const filters = [
  { key: 'all', label: 'All', flag: null, count: photos.length },
  ...presentCountries.map(code => ({
    key: code,
    label: COUNTRIES[code]?.label || code.toUpperCase(),
    flag: COUNTRIES[code]?.flag || null,
    count: photos.filter(p => p.place === code).length,
  })),
];

