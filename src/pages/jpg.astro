---
import Analytics from "@vercel/analytics/astro"
import PupvanhFooter from '../components/PupvanhFooter.astro';

// Alle foto's — data-driven, makkelijk toe te voegen via GitHub
const photos = [
  { file:'fr-08-cappy-somme.jpg',        size:'tall', place:'fr', title:'Along the Somme',              loc:'Cappy',                    date:'07.2026' },
