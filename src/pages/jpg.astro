  { file:'be-04-cappy-reflection.jpg',   size:'tall', place:'fr', title:'Sky in the water',             loc:'Cappy',                    date:'06.2025' },
  { file:'be-05-cappy-boats.jpg',        size:'tall', place:'fr', title:'Two boats, one shed',          loc:'Cappy',                    date:'06.2025' },
  { file:'be-02-cappy-river.jpg',        size:'tall', place:'fr', title:'River bend',                   loc:'Cappy',                    date:'06.2025' },
  { file:'be-06-cappy-neighbor.jpg',     size:'tall', place:'fr', title:'The neighbour photographs back',loc:'Cappy',                   date:'06.2025' },
  { file:'be-03-cappy-lilies.jpg',       size:'tall', place:'fr', title:'Lilies on still water',        loc:'Cappy',                    date:'06.2025' },
  { file:'be-07-cappy-kite.jpg',         size:'tall', place:'fr', title:'A kite at dusk',              loc:'Cappy',                    date:'06.2025' },
  { file:'italy-06-riomaggiore.jpg',     size:'tall', place:'it', title:'Painted houses at the port',   loc:'Riomaggiore, Cinque Terre',date:'08.2024' },
  { file:'italy-03-turin.jpg',           size:'tall', place:'it', title:'Via Roma, golden hour',        loc:'Turin, Italy',             date:'08.2024' },
  { file:'italy-07-manarola.jpg',        size:'tall', place:'it', title:'Laundry over the alley',       loc:'Manarola, Cinque Terre',   date:'08.2024' },
  { file:'italy-04-venice-canal.jpg',    size:'tall', place:'it', title:'Grand Canal, from the bridge', loc:'Venice, Italy',            date:'08.2024' },
  { file:'italy-05-venice-artist.jpg',   size:'tall', place:'it', title:'The artist reads on',          loc:'Venice, Italy',            date:'08.2024' },
  { file:'bled-01-kayak.jpg',            size:'wide', place:'si', title:'Kayak past the island',        loc:'Lake Bled, Slovenia',      date:'07.2024' },
  { file:'italy-01-dolomites.jpg',       size:'tall', place:'it', title:'Alpenglow, Alta Badia',        loc:'Alta Badia, Dolomites',    date:'07.2024' },
