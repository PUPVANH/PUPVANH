function pupsSetLanguage(lang) {
  if (!pupsI18n[lang]) return;
  document.documentElement.lang = lang;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (pupsI18n[lang][key] !== undefined) {
      el.innerHTML = pupsI18n[lang][key];
    }
  });
  document.querySelectorAll('.pups-lang-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.lang === lang);
  });
  try { localStorage.setItem('pups-lang', lang); } catch(e) {}
  // Re-render swatch labels
  if (typeof renderSwatchLabels === 'function') renderSwatchLabels(lang);
}

