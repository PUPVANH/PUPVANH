function renderProductCards(containerId, filterFamily) {
  const grid = document.getElementById(containerId);
  if (!grid) return;
  const lang = document.documentElement.lang || 'nl';
  const products = filterFamily
    ? pupsProducts.filter(p => p.family === filterFamily)
    : pupsProducts;
  grid.innerHTML = products.map(p => {
    const first = p.colors[0];
    const hasViews = !!(first.views && first.views.length > 1);
    const swatches = p.colors.length > 1 ? p.colors.map((c, i) =>
      `<button class="swatch${i === 0 ? ' active' : ''}" style="background:${c.hex};" data-img="${c.img}" data-views='${JSON.stringify(c.views || [c.img])}' data-name="${c.name}" aria-label="${c.name}" title="${c.name}"></button>`
    ).join('') : '';
    const familyBadge = p.family === 'vinnie' ? 'Vinnie' : 'OG Pup';
    return `
      <article class="product-card${hasViews ? ' has-views' : ''}" data-family="${p.family}" data-id="${p.id}" data-view-index="0">
        <div class="product-image" data-views='${JSON.stringify(first.views || [first.img])}'>
          <img class="product-image-img" src="${first.img}" alt="${p.name[lang]}">
        </div>
        <div class="product-body">
          <div class="product-badge-row">
            <span class="product-family-badge ${p.family}">${familyBadge}</span>
            ${swatches ? `<div class="swatches">${swatches}</div>` : ''}
          </div>
          <div class="product-name" data-name-nl="${p.name.nl}" data-name-en="${p.name.en}">${p.name[lang]}</div>
          <div class="product-tag" data-tag-nl="${p.tag.nl}" data-tag-en="${p.tag.en}">${p.tag[lang]}</div>
        </div>
      </article>
    `;
  }).join('');

  // Klik op product-image = cycle door views (indien meerdere)
  grid.querySelectorAll('.product-card').forEach(card => {
    const imgWrap = card.querySelector('.product-image');
    const img = card.querySelector('.product-image-img');
    imgWrap.addEventListener('click', (e) => {
      if (e.target.closest('.swatch')) return;
      const views = JSON.parse(imgWrap.dataset.views || '[]');
      if (views.length < 2) return;
      let idx = parseInt(card.dataset.viewIndex || '0', 10);
      idx = (idx + 1) % views.length;
      card.dataset.viewIndex = idx;
      img.src = views[idx];
    });
  });

  // Klik op kleur-bolletje = wisselt naar die kleur (met de default view)
  grid.querySelectorAll('.swatch').forEach(sw => {
    sw.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = sw.closest('.product-card');
      if (!card) return;
      const img = card.querySelector('.product-image-img');
      const imgWrap = card.querySelector('.product-image');
      const views = JSON.parse(sw.dataset.views || '[]');
      if (img) img.src = sw.dataset.img;
      imgWrap.dataset.views = sw.dataset.views;
      card.dataset.viewIndex = '0';
      // Update has-views state
      if (views.length > 1) card.classList.add('has-views');
      else card.classList.remove('has-views');
      card.querySelectorAll('.swatch').forEach(s => s.classList.remove('active'));
      sw.classList.add('active');
    });
  });
}

function renderSwatchLabels(lang) {
  // Update product name/tag when language changes
  document.querySelectorAll('.product-card').forEach(card => {
    const nameEl = card.querySelector('.product-name');
    if (nameEl && nameEl.dataset['name' + (lang === 'en' ? 'En' : 'Nl')]) {
      nameEl.textContent = nameEl.dataset['name' + (lang === 'en' ? 'En' : 'Nl')];
    }
    const tagEl = card.querySelector('.product-tag');
    if (tagEl && tagEl.dataset['tag' + (lang === 'en' ? 'En' : 'Nl')]) {
      tagEl.textContent = tagEl.dataset['tag' + (lang === 'en' ? 'En' : 'Nl')];
    }
  });
}

document.addEventListener('DOMContentLoaded', () => {
  // Language switcher init
  document.querySelectorAll('.pups-lang-btn').forEach(btn => {
    btn.addEventListener('click', () => pupsSetLanguage(btn.dataset.lang));
  });
  const savedLang = localStorage.getItem('pups-lang');
  if (savedLang && pupsI18n[savedLang]) {
    pupsSetLanguage(savedLang);
  } else {
    const browserLang = (navigator.language || 'nl').slice(0, 2);
    pupsSetLanguage(pupsI18n[browserLang] ? browserLang : 'nl');
  }

  // View switching
  function showView(name) {
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    const target = document.getElementById('view-' + name);
    if (target) target.classList.add('active');
    document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
    if (name === 'vinnie') {
      const el = document.querySelector('.nav-vinnie'); if (el) el.classList.add('active');
    } else {
      const el = document.querySelector('.nav-collection'); if (el) el.classList.add('active');
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  function scrollToId(id) {
    setTimeout(() => {
      const el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior:'smooth', block:'start' });
    }, 100);
  }

  document.querySelectorAll('[data-view]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      showView(el.dataset.view);
      if (el.dataset.scroll) scrollToId(el.dataset.scroll);
    });
  });

  // Rain mode
  let raining = false;
  function startRain() {
    if (raining) return;
    raining = true;
    const btn = document.getElementById('rainBtn');
    btn.classList.add('raining');
    btn.disabled = true;
    btn.textContent = '🌧️ Raining...';
    const rainLayer = document.getElementById('pup-rain');
    const spawnStart = Date.now();
    const spawnDuration = 5000;
    const drops = [];
    const spawnInterval = setInterval(() => {
      if (Date.now() - spawnStart >= spawnDuration) {
        clearInterval(spawnInterval);
        return;
      }
      for (let i = 0; i < 3; i++) {
        const pupSrc = rainPups[Math.floor(Math.random() * rainPups.length)];
        const el = document.createElement('img');
        el.src = pupSrc;
        el.className = 'rain-drop';
        el.style.left = (Math.random() * 100) + 'vw';
        el.style.top = '-100px';
        const size = 50 + Math.random() * 60;
        el.style.width = size + 'px';
        el.style.height = size + 'px';
        rainLayer.appendChild(el);
        drops.push({
          el, x: parseFloat(el.style.left), y: -100,
          vy: 2 + Math.random() * 4, vx: (Math.random() - 0.5) * 2,
          rot: 0, vr: (Math.random() - 0.5) * 6
        });
      }
    }, 60);
    function frame() {
      drops.forEach((d) => {
        if (!d.el.parentNode) return;
        d.y += d.vy;
        d.vy += 0.08;
        d.rot += d.vr;
        d.el.style.top = d.y + 'px';
        d.el.style.transform = `translateX(${d.vx * d.y * 0.02}px) rotate(${d.rot}deg)`;
        if (d.y > window.innerHeight + 100) d.el.remove();
      });
      for (let i = drops.length - 1; i >= 0; i--) {
        if (!drops[i].el.parentNode) drops.splice(i, 1);
      }
      if (drops.length > 0 || Date.now() - spawnStart < spawnDuration) {
        requestAnimationFrame(frame);
      } else {
        raining = false;
        btn.classList.remove('raining');
        btn.disabled = false;
        btn.textContent = '🌧️ Rain mode';
      }
    }
    requestAnimationFrame(frame);
  }
  document.getElementById('rainBtn').addEventListener('click', startRain);
  document.getElementById('ctaDMBtn').addEventListener('click', () => {
    startRain();
    setTimeout(() => window.open('https://instagram.com/po.pups', '_blank'), 300);
  });
  document.querySelectorAll('.pup-wall-track img').forEach(img => {
    img.addEventListener('click', () => startRain());
  });

  // Product cards render (main + vinnie subpage)
  renderProductCards('productGridMain', null);
  renderProductCards('productGridVinnie', 'vinnie');

  // Draggable pup
  const dragPup = document.getElementById('dragPup');
  let isDragging = false, offsetX = 0, offsetY = 0;
  function startDrag(e) {
    isDragging = true;
    const rect = dragPup.getBoundingClientRect();
    const p = e.touches ? e.touches[0] : e;
    offsetX = p.clientX - rect.left;
    offsetY = p.clientY - rect.top;
    dragPup.style.animation = 'none';
    dragPup.style.transition = 'none';
  }
  function drag(e) {
    if (!isDragging) return;
    const p = e.touches ? e.touches[0] : e;
    dragPup.style.left = (p.clientX - offsetX) + 'px';
    dragPup.style.top = (p.clientY - offsetY) + 'px';
    dragPup.style.right = 'auto';
    dragPup.style.bottom = 'auto';
    e.preventDefault();
  }
  function endDrag() { isDragging = false; }
  dragPup.addEventListener('mousedown', startDrag);
  dragPup.addEventListener('touchstart', startDrag);
  document.addEventListener('mousemove', drag);
  document.addEventListener('touchmove', drag, { passive:false });
  document.addEventListener('mouseup', endDrag);
  document.addEventListener('touchend', endDrag);

  // 3D tilt
  document.querySelectorAll('[data-tilt]').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const cx = rect.width / 2;
      const cy = rect.height / 2;
      const rotateX = (y - cy) / cy * -8;
      const rotateY = (x - cx) / cx * 8;
      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
    });
    card.addEventListener('mouseleave', () => { card.style.transform = ''; });
  });
});
</script>
