---
// pups.astro - PUPVANH subpage
// Pups by Puppy - hondgeïnspireerde streetwear
import PupvanhFooter from '../components/PupvanhFooter.astro';
---
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pups — by Puppy</title>
<link rel="icon" type="image/png" href="/pups/designs/og.png" />
<meta name="description" content="Hondgeïnspireerde streetwear met eigen creaties. Kleinschalig, made on order, en enkel via DM te bestellen.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<style is:global>
.pups-page {
  --pups-bg: #F5EBD9; --pups-bg-alt: #ECDDC3;
  --pups-ink: #2A1810; --pups-ink-soft: #5C4636;
  --pups-accent: #E85D2F; --pups-accent-2: #F2A93D; --pups-accent-3: #7BAE7F;
  --pups-accent-soft: #F4A78D; --pups-cream: #FFFBF3;
  --pups-line: rgba(42,24,16,0.12); --pups-shadow: rgba(232,93,47,0.15);
  --pups-card: #FFFBF3;
  font-family:'Inter', sans-serif;
  background:var(--pups-bg); color:var(--pups-ink);
  line-height:1.55; position:relative; overflow-x:hidden;
  min-height:100vh;
}
.pups-page * { margin:0; padding:0; box-sizing:border-box; }
.pups-page::before {
  content:''; position:fixed; inset:0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
  opacity:0.07; pointer-events:none; z-index:1; mix-blend-mode:multiply;
}
.pups-page section, .pups-page header, .pups-page footer, .pups-page .announce, .pups-page .pup-wall, .pups-page .rain-btn, .pups-page .drag-pup { position:relative; z-index:2; }

.pups-page .drag-pup {
  position:fixed; bottom:100px; right:30px;
  width:80px; height:80px; cursor:grab; z-index:100;
  transition: transform 0.3s;
  filter: drop-shadow(0 4px 12px rgba(42,24,16,0.25));
  animation: pupsBob 3s ease-in-out infinite;
}
.pups-page .drag-pup:hover { transform: scale(1.1) rotate(-8deg); }
.pups-page .drag-pup:active { cursor:grabbing; animation:none; }
.pups-page .drag-pup img { width:100%; height:100%; pointer-events:none; }
.pups-page .drag-pup .drag-hint {
  position:absolute; bottom:-24px; left:50%; transform:translateX(-50%);
  background:var(--pups-ink); color:var(--pups-cream);
  padding:4px 10px; border-radius:100px;
  font-family:'JetBrains Mono', monospace;
  font-size:9px; text-transform:uppercase; letter-spacing:0.1em;
  white-space:nowrap; opacity:0; transition: opacity 0.2s;
}
.pups-page .drag-pup:hover .drag-hint { opacity:1; }
@keyframes pupsBob { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-8px);} }

.pups-page .rain-btn {
  position:fixed; bottom:30px; right:30px;
  background:var(--pups-ink); color:var(--pups-cream);
  border:2px solid var(--pups-ink);
  padding:14px 20px; border-radius:100px;
  font-family:'JetBrains Mono', monospace;
  font-size:11px; text-transform:uppercase; letter-spacing:0.1em;
  cursor:pointer; z-index:100; transition: all 0.2s;
  font-weight:600; box-shadow: 0 4px 12px rgba(42,24,16,0.2);
}
.pups-page .rain-btn:hover { background:var(--pups-accent); transform:translateY(-2px); }
.pups-page .rain-btn.raining { background:var(--pups-accent-3); }
.pups-page .rain-btn:disabled { opacity:0.6; cursor:not-allowed; }

.pups-page .announce {
  background:var(--pups-ink); color:var(--pups-cream);
  text-align:center; padding:10px 20px;
  font-family:'JetBrains Mono', monospace;
  font-size:11px; text-transform:uppercase; letter-spacing:0.15em;
}
.pups-page .announce span { color:var(--pups-accent-2); }

.pups-page .nav {
  padding:20px 40px;
  display:flex; justify-content:space-between; align-items:center;
  border-bottom:1px solid var(--pups-line); background:var(--pups-bg);
  position:sticky; top:0; z-index:50; backdrop-filter: blur(8px);
}
.pups-page .nav-brand {
  display:flex; align-items:center; gap:12px;
  position:absolute; left:50%; transform:translateX(-50%);
  cursor:pointer;
}
.pups-page .nav-brand img {
  width:44px; height:44px; border-radius:50%;
  background:var(--pups-accent-soft); padding:2px; transition:transform 0.3s;
}
.pups-page .nav-brand:hover img { transform:rotate(15deg); }
.pups-page .nav-brand-name {
  font-family:'Bebas Neue', sans-serif;
  font-size:28px; letter-spacing:0.12em; color:var(--pups-ink);
}
.pups-page .nav-links {
  display:flex; gap:22px;
  font-family:'JetBrains Mono', monospace;
  font-size:12px; text-transform:uppercase; letter-spacing:0.1em;
}
.pups-page .nav-links a {
  color:var(--pups-ink-soft); text-decoration:none;
  transition: color 0.2s; cursor:pointer; position:relative;
}
.pups-page .nav-links a:hover { color:var(--pups-accent); }
.pups-page .nav-links a.active { color:var(--pups-accent); }
.pups-page .nav-links a.active::after {
  content:''; position:absolute; bottom:-6px; left:0; right:0;
  height:2px; background:var(--pups-accent);
}

/* NL / EN language switcher */
.pups-page .pups-lang {
  display:flex; align-items:center; gap:6px;
  margin-left:12px; padding-left:20px;
  border-left:1px solid var(--pups-line);
  font-family:'Space Grotesk','Inter',sans-serif;
}
.pups-page .pups-lang-btn {
  background:transparent; border:none; padding:0; cursor:pointer;
  font:inherit; font-size:14px; font-weight:500;
  letter-spacing:0.5px; color:var(--pups-ink);
  opacity:0.5; transition:opacity 0.2s, color 0.2s;
}
.pups-page .pups-lang-btn:hover { opacity:0.8; }
.pups-page .pups-lang-btn.active { opacity:1; color:var(--pups-accent); }
.pups-page .pups-lang-sep { opacity:0.3; font-size:12px; }

.pups-page .view { display:none; animation: pupsFadeIn 0.5s ease; }
.pups-page .view.active { display:block; }
@keyframes pupsFadeIn { from{opacity:0;transform:translateY(20px);} to{opacity:1;transform:translateY(0);} }

.pups-page .hero {
  padding:80px 40px 100px;
  display:grid; grid-template-columns: 1.1fr 1fr;
  gap:60px; align-items:center;
  max-width:1400px; margin:0 auto;
}
.pups-page .hero-kicker {
  font-family:'JetBrains Mono', monospace;
  font-size:12px; text-transform:uppercase; letter-spacing:0.15em;
  color:var(--pups-accent); margin-bottom:24px;
  display:flex; align-items:center; gap:12px; font-weight:500;
}
.pups-page .hero-kicker::before { content:''; width:24px; height:1px; background:var(--pups-accent); }
.pups-page .hero-title {
  font-family:'Bebas Neue', sans-serif;
  font-size:clamp(80px, 13vw, 200px);
  line-height:0.82; letter-spacing:0.02em;
  color:var(--pups-ink); margin-bottom:24px;
}
.pups-page .hero-title .accent { color:var(--pups-accent); }
.pups-page .hero-title .serif {
  color:var(--pups-ink-soft); font-style:italic;
  font-family:'DM Serif Display', serif;
  font-size:0.6em; letter-spacing:-0.02em; font-weight:400;
}
.pups-page .hero-lead {
  font-size:18px; line-height:1.65; color:var(--pups-ink-soft);
  max-width:480px; margin-bottom:36px;
}
.pups-page .hero-lead strong { color:var(--pups-ink); font-weight:600; }
.pups-page .hero-ctas { display:flex; gap:14px; flex-wrap:wrap; }
.pups-page .hero-cta {
  display:inline-flex; align-items:center; gap:10px;
  padding:16px 28px;
  background:var(--pups-ink); color:var(--pups-cream);
  text-decoration:none;
  font-family:'JetBrains Mono', monospace;
  font-size:13px; text-transform:uppercase; letter-spacing:0.1em;
  border-radius:100px; transition: all 0.2s; font-weight:500;
  cursor:pointer; border:none;
}
.pups-page .hero-cta:hover { background:var(--pups-accent); transform: translateY(-2px); }
.pups-page .hero-cta.secondary { background:transparent; color:var(--pups-ink); border:1.5px solid var(--pups-ink); }
.pups-page .hero-cta.secondary:hover { background:var(--pups-ink); color:var(--pups-cream); }
.pups-page .hero-image {
  position:relative; aspect-ratio:4/5;
  border-radius:16px; overflow:hidden;
  border:2px solid var(--pups-ink);
  box-shadow: 12px 12px 0 var(--pups-accent-2);
}
.pups-page .hero-image img { width:100%; height:100%; object-fit:cover; transition: transform 6s ease-in-out; }
.pups-page .hero-image:hover img { transform: scale(1.06); }
.pups-page .hero-sticker {
  position:absolute; z-index:3;
  background:var(--pups-accent); color:var(--pups-cream);
  padding:14px 22px; border-radius:100px;
  font-family:'JetBrains Mono', monospace;
  font-size:11px; text-transform:uppercase; letter-spacing:0.1em;
  font-weight:600; transform:rotate(-8deg);
  box-shadow: 0 6px 20px var(--pups-shadow);
}
.pups-page .hero-sticker.top-right { top:20px; right:20px; }
.pups-page .hero-sticker.bottom-left { bottom:20px; left:20px; background:var(--pups-accent-3); transform:rotate(8deg); }

.pups-page .pup-wall {
  background: var(--pups-bg-alt);
  padding:32px 0; overflow:hidden;
  border-top:2px solid var(--pups-ink); border-bottom:2px solid var(--pups-ink);
}
.pups-page .pup-wall-track {
  display:flex; gap:40px; align-items:center;
  animation: pupsScroll 60s linear infinite; width:max-content;
}
.pups-page .pup-wall-track img { height:110px; width:auto; transition: transform 0.3s; cursor:pointer; }
.pups-page .pup-wall-track img:hover { transform: scale(1.2) rotate(-5deg); }
@keyframes pupsScroll { from{transform:translateX(0);} to{transform:translateX(-50%);} }

.pups-page .lookbook { padding:100px 40px; background:var(--pups-bg); }
.pups-page .lookbook-inner { max-width:1400px; margin:0 auto; }
.pups-page .lookbook-grid {
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 280px; gap:14px;
  margin-top:40px;
}
.pups-page .lookbook-item {
  overflow:hidden; border-radius:8px; position:relative;
  border:1.5px solid var(--pups-ink);
}
.pups-page .lookbook-item img { width:100%; height:100%; object-fit:cover; transition: transform 0.7s; }
.pups-page .lookbook-item:hover img { transform: scale(1.05); }
.pups-page .lookbook-item.tall { grid-row: span 2; }
.pups-page .lookbook-item.wide { grid-column: span 2; }

.pups-page .section { padding:100px 40px; max-width:1400px; margin:0 auto; }
.pups-page .section-header {
  display:flex; justify-content:space-between; align-items:flex-end;
  margin-bottom:56px; padding-bottom:24px;
  border-bottom:2px solid var(--pups-ink);
}
.pups-page .section-kicker {
  font-family:'JetBrains Mono', monospace;
  font-size:12px; text-transform:uppercase; letter-spacing:0.15em;
  color:var(--pups-accent); margin-bottom:12px; font-weight:600;
}
.pups-page .section-title {
  font-family:'Bebas Neue', sans-serif;
  font-size:80px; line-height:1; letter-spacing:0.02em; color:var(--pups-ink);
}
.pups-page .section-title em {
  font-family:'DM Serif Display', serif;
  font-style:italic; color:var(--pups-accent);
  font-size:0.82em; letter-spacing:-0.02em;
}
.pups-page .section-meta {
  font-family:'JetBrains Mono', monospace;
  font-size:12px; text-transform:uppercase; letter-spacing:0.1em;
  color:var(--pups-ink-soft); text-align:right; line-height:1.7;
}
.pups-page .section-meta strong { color:var(--pups-accent); font-weight:600; }

.pups-page .design-grid {
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap:24px;
}
.pups-page .design-card {
  background:var(--pups-card); border:1.5px solid var(--pups-ink);
  border-radius:12px; overflow:hidden;
  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s;
  cursor:pointer; transform-style: preserve-3d; perspective: 1000px;
}
.pups-page .design-card:hover { box-shadow: 6px 6px 0 var(--pups-accent); }
.pups-page .design-image {
  aspect-ratio: 1/1; background: var(--pups-bg);
  display:flex; align-items:center; justify-content:center;
  border-bottom:1.5px solid var(--pups-ink); overflow:hidden;
}
.pups-page .design-image img {
  width:78%; height:78%; object-fit:contain;
  transition: transform 0.4s;
}
.pups-page .design-card:hover .design-image img { transform: scale(1.08) rotate(-2deg); }
.pups-page .design-body { padding:18px 20px; text-align:center; }
.pups-page .design-name {
  font-family:'DM Serif Display', serif;
  font-size:22px; line-height:1.15;
  color:var(--pups-ink); margin-bottom:4px;
}
.pups-page .design-tag {
  font-family:'JetBrains Mono', monospace;
  font-size:10px; text-transform:uppercase; letter-spacing:0.12em;
  color:var(--pups-ink-soft);
}

.pups-page .merch-section {
  padding:100px 40px;
  background: linear-gradient(180deg, var(--pups-bg) 0%, var(--pups-bg-alt) 100%);
  border-top:2px solid var(--pups-ink);
}
.pups-page .merch-inner { max-width:1400px; margin:0 auto; }
.pups-page .merch-grid {
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap:20px;
}
.pups-page .merch-card {
  background:var(--pups-cream); border:1.5px solid var(--pups-ink);
  border-radius:12px; overflow:hidden; transition: all 0.3s;
}
.pups-page .merch-card:hover { transform: translateY(-4px); box-shadow: 4px 4px 0 var(--pups-accent-2); }
.pups-page .merch-image {
  aspect-ratio: 1/1; background:#fff; overflow:hidden;
  display:flex; align-items:center; justify-content:center;
  border-bottom:1.5px solid var(--pups-ink); position:relative;
}
.pups-page .merch-image img { width:100%; height:100%; object-fit:contain; }

.pups-page .tote-flip { cursor:pointer; position:relative; }
.pups-page .tote-flip .merch-image { perspective:800px; }
.pups-page .tote-flip .tote-front, .pups-page .tote-flip .tote-back {
  position:absolute; inset:0;
  backface-visibility: hidden;
  transition: transform 0.6s;
}
.pups-page .tote-flip .tote-back { transform: rotateY(180deg); }
.pups-page .tote-flip.flipped .tote-front { transform: rotateY(180deg); }
.pups-page .tote-flip.flipped .tote-back { transform: rotateY(0deg); }
.pups-page .tote-flip::after {
  content:'⇄'; position:absolute; top:10px; right:10px;
  background:var(--pups-ink); color:var(--pups-cream);
  width:26px; height:26px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:14px; font-weight:bold;
  z-index:2; pointer-events:none;
}

.pups-page .merch-body { padding:16px 18px; }
.pups-page .merch-name {
  font-family:'DM Serif Display', serif;
  font-size:18px; line-height:1.2; color:var(--pups-ink); margin-bottom:4px;
}
.pups-page .merch-tag {
  font-family:'JetBrains Mono', monospace;
  font-size:10px; text-transform:uppercase; letter-spacing:0.1em; color:var(--pups-ink-soft);
}

/* Product cards v3 — geen flip, kleur-bolletjes op voorkant naast badge */
.pups-page .product-card {
  background:var(--pups-cream); border:1.5px solid var(--pups-ink);
  border-radius:12px; overflow:hidden; transition: all 0.3s;
  position:relative;
  display:flex; flex-direction:column;
}
.pups-page .product-card:hover { transform: translateY(-4px); box-shadow: 4px 4px 0 var(--pups-accent-2); }
.pups-page .product-card.has-views .product-image {
  cursor:pointer;
}
.pups-page .product-card.has-views::after {
  content:'⇄'; position:absolute; top:10px; right:10px;
  background:var(--pups-ink); color:var(--pups-cream);
  width:26px; height:26px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:14px; font-weight:bold;
  z-index:5; pointer-events:none;
}
.pups-page .product-image {
  aspect-ratio: 1/1; background:#fff; overflow:hidden;
  display:flex; align-items:center; justify-content:center;
  border-bottom:1.5px solid var(--pups-ink); position:relative;
}
.pups-page .product-image img { width:100%; height:100%; object-fit:contain; transition: opacity 0.2s; }
.pups-page .product-body { padding:14px 18px; }
.pups-page .product-badge-row {
  display:flex; align-items:center; gap:10px; flex-wrap:wrap;
  margin-bottom:8px;
}
.pups-page .product-family-badge {
  display:inline-block;
  font-family:'JetBrains Mono', monospace;
  font-size:9px; text-transform:uppercase; letter-spacing:0.15em;
  padding:3px 8px; border-radius:100px;
  background:var(--pups-ink); color:var(--pups-cream);
  font-weight:600; flex-shrink:0;
}
.pups-page .product-family-badge.vinnie { background:var(--pups-accent); }
.pups-page .swatches {
  display:flex; flex-wrap:wrap; gap:6px;
}
.pups-page .swatch {
  width:18px; height:18px; border-radius:50%;
  cursor:pointer; border:1.5px solid var(--pups-ink);
  transition: transform 0.15s, box-shadow 0.2s;
  padding:0; background-clip:padding-box;
}
.pups-page .swatch:hover { transform:scale(1.2); }
.pups-page .swatch.active {
  box-shadow: 0 0 0 1.5px var(--pups-cream), 0 0 0 3px var(--pups-accent);
  transform:scale(1.15);
}
.pups-page .product-name {
  font-family:'DM Serif Display', serif;
  font-size:20px; line-height:1.2; color:var(--pups-ink); margin-bottom:4px;
}
.pups-page .product-tag {
  font-family:'JetBrains Mono', monospace;
  font-size:10px; text-transform:uppercase; letter-spacing:0.1em; color:var(--pups-ink-soft);
}

/* Product grid v2 */
.pups-page .product-grid {
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap:22px;
}

.pups-page .animals { padding:120px 40px; max-width:1200px; margin:0 auto; }
.pups-page .animals-header { text-align:center; margin-bottom:64px; }
.pups-page .animals-kicker {
  font-family:'JetBrains Mono', monospace;
  font-size:12px; text-transform:uppercase; letter-spacing:0.15em;
  color:var(--pups-accent); margin-bottom:12px; font-weight:600;
}
.pups-page .animals-title {
  font-family:'Bebas Neue', sans-serif;
  font-size:80px; line-height:1; letter-spacing:0.02em;
}
.pups-page .animals-title em {
  font-family:'DM Serif Display', serif;
  font-style:italic; color:var(--pups-accent); font-size:0.82em;
}
.pups-page .animals-grid {
  display:grid; grid-template-columns: repeat(2, 1fr); gap:32px;
}
.pups-page .animal-card {
  background:var(--pups-card); border:2px solid var(--pups-ink);
  border-radius:16px; padding:32px;
  text-align:center; transition: all 0.3s; position:relative;
}
.pups-page .animal-card:hover { transform: translateY(-6px); box-shadow: 0 12px 24px var(--pups-shadow); }
.pups-page .animal-card .animal-badge {
  position:absolute; top:-14px; right:20px;
  background:var(--pups-accent); color:var(--pups-cream);
  padding:5px 12px; border-radius:100px;
  font-family:'JetBrains Mono', monospace;
  font-size:10px; text-transform:uppercase; letter-spacing:0.1em;
  font-weight:600; border:1.5px solid var(--pups-ink);
}
.pups-page .animal-photo {
  aspect-ratio: 1/1; border-radius:12px; overflow:hidden;
  border:1.5px solid var(--pups-ink);
  margin-bottom:20px; position:relative;
}
.pups-page .animal-photo img { width:100%; height:100%; object-fit:cover; transition:transform 0.5s; }
.pups-page .animal-card:hover .animal-photo img { transform:scale(1.05); }
.pups-page .animal-name {
  font-family:'Bebas Neue', sans-serif;
  font-size:52px; color:var(--pups-ink); letter-spacing:0.03em; margin-bottom:6px;
}
.pups-page .animal-role {
  font-family:'JetBrains Mono', monospace;
  font-size:11px; text-transform:uppercase; letter-spacing:0.15em;
  color:var(--pups-accent); margin-bottom:14px; font-weight:600;
}
.pups-page .animal-desc {
  font-size:15px; line-height:1.6;
  color:var(--pups-ink-soft); margin-bottom:16px;
}
.pups-page .animal-cta {
  display:inline-flex; align-items:center; gap:6px;
  padding:8px 16px;
  background:var(--pups-ink); color:var(--pups-cream);
