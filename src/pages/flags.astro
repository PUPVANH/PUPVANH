---
// FLAGS.EXE — subpagina van PUPVANH
// Windows 95 vibe · 197 landen · NL/EN · vlaggen uit /public/flag-images/
---
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FLAGS.EXE — PUPVANH</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=VT323&family=Pixelify+Sans:wght@400;700&family=Kalam:wght@400;700&family=Caveat:wght@400;700&display=swap" rel="stylesheet">
<style is:global>
/* ========= Windows 95 tokens ========= */
:root {
  --desktop: #008080;
  --face: #c0c0c0;
  --face-light: #dfdfdf;
  --face-dark: #808080;
  --white: #ffffff;
  --black: #000000;
  --titlebar: #000080;
  --titlebar-2: #1084d0;
  --highlight: #000080;
  --text: #000000;
  --disabled: #808080;
  --input-bg: #ffffff;
  --link: #0000ee;
  --lcd-bg: #000000;
  --lcd-fg: #0f0;
  --gold: #c8a35f;
  --ember: #e85d2f;
  --success-bg: #008000;
  --error-bg: #800000;

  --ui-font: "Tahoma", "MS Sans Serif", "Geneva", "Verdana", sans-serif;
  --pixel-font: "Pixelify Sans", "VT323", "Courier New", monospace;
  --lcd-font: "VT323", "Courier New", monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }

body {
  background: var(--desktop);
  color: var(--text);
  font-family: var(--ui-font);
  font-size: 11px;
  min-height: 100vh;
  padding: 20px 16px;
  overflow-x: hidden;
  background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.06) 1px, transparent 0);
  background-size: 20px 20px;
}

.win {
  background: var(--face);
  border-top: 2px solid var(--white);
  border-left: 2px solid var(--white);
  border-right: 2px solid var(--black);
  border-bottom: 2px solid var(--black);
  box-shadow: inset -1px -1px 0 var(--face-dark), inset 1px 1px 0 var(--face-light);
  padding: 2px;
  max-width: 780px;
  margin: 0 auto;
}

.titlebar {
  background: linear-gradient(90deg, var(--titlebar) 0%, var(--titlebar-2) 100%);
  color: var(--white);
  padding: 3px 4px 3px 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
  font-size: 11px;
  height: 22px;
}
.titlebar-text { display: flex; align-items: center; gap: 6px; overflow: hidden; white-space: nowrap; }
.titlebar-icon { width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }
.titlebar-controls { display: flex; gap: 2px; }
.titlebar-btn {
  background: var(--face);
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--black); border-bottom: 1px solid var(--black);
  box-shadow: inset -1px -1px 0 var(--face-dark);
  width: 18px; height: 16px; padding: 0;
  font-family: var(--ui-font); font-size: 10px; font-weight: 700;
  color: var(--black); cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center; line-height: 1;
}
.titlebar-btn:active {
  border-top: 1px solid var(--black); border-left: 1px solid var(--black);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  box-shadow: inset 1px 1px 0 var(--face-dark);
}

.menubar {
  display: flex; align-items: center; padding: 2px 4px; gap: 2px;
  border-bottom: 1px solid var(--face-dark); background: var(--face);
}
.menu-item { padding: 3px 8px; font-size: 11px; cursor: default; user-select: none; }
.menu-item:hover:not(.no-hover) { background: var(--highlight); color: var(--white); }
.menu-item u { text-decoration: underline; }
.menubar-spacer { flex: 1; }
.lang-switch { padding: 0 4px; font-size: 11px; }
.lang-btn {
  background: transparent; border: none; padding: 2px 4px;
  cursor: pointer; font-family: inherit; font-size: 11px; color: var(--text);
}
.lang-btn.active { background: var(--highlight); color: var(--white); font-weight: 700; }
.lang-switch .sep { color: var(--face-dark); margin: 0 2px; }

.window-body { padding: 12px; }

.statusbar {
  display: flex; border-top: 1px solid var(--white); padding: 2px; gap: 2px;
}
.statusbar-cell {
  flex: 1;
  border-top: 1px solid var(--face-dark); border-left: 1px solid var(--face-dark);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  padding: 2px 6px; font-size: 11px; background: var(--face);
}
.statusbar-cell.narrow { flex: 0 0 auto; min-width: 90px; }

.screen { display: none; }
.screen.active { display: block; }

/* Setup */
.brand-block {
  text-align: center; padding: 20px 12px 12px; background: var(--face);
  border-top: 1px solid var(--face-dark); border-left: 1px solid var(--face-dark);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  box-shadow: inset 1px 1px 0 var(--black); margin-bottom: 12px;
  background-image: linear-gradient(135deg, #f0f0f0 0%, #c0c0c0 100%);
}
.brand {
  font-family: var(--pixel-font); font-size: 72px; font-weight: 700;
  letter-spacing: -3px; line-height: 0.9; color: var(--titlebar);
  text-shadow: 3px 3px 0 var(--gold), 6px 6px 0 var(--face-dark); margin: 0;
}
.tagline {
  font-family: var(--lcd-font); font-size: 18px; color: var(--text);
  letter-spacing: 1px; margin-top: 6px;
}

.dialog-group {
  background: var(--face);
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--face-dark); border-bottom: 1px solid var(--face-dark);
  padding: 12px; margin-bottom: 12px;
}
.dialog-title {
  font-weight: 700; font-size: 11px; margin-bottom: 10px;
  padding-bottom: 6px; border-bottom: 1px solid var(--face-dark);
  box-shadow: 0 1px 0 var(--white); display: flex; align-items: center; gap: 6px;
}
.dialog-title::before {
  content: ''; display: inline-block; width: 8px; height: 8px; background: var(--titlebar);
}

fieldset {
  border: 1px solid var(--face-dark);
  box-shadow: 1px 1px 0 var(--white), inset -1px -1px 0 var(--white), inset 1px 1px 0 var(--face-dark);
  padding: 10px 12px; margin-bottom: 10px;
}
fieldset legend { padding: 0 4px; font-weight: 700; font-size: 11px; }

.radio-row { display: flex; gap: 20px; flex-wrap: wrap; }
.radio-row label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11px; }
.radio-row input[type=radio] { width: 13px; height: 13px; margin: 0; cursor: pointer; }

.chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
.chip {
  background: var(--face);
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--black); border-bottom: 1px solid var(--black);
  box-shadow: inset -1px -1px 0 var(--face-dark), inset 1px 1px 0 var(--face-light);
  padding: 4px 12px; font-family: inherit; font-size: 11px;
  cursor: pointer; color: var(--text); min-width: 68px;
}
.chip:active, .chip.active {
  border-top: 1px solid var(--black); border-left: 1px solid var(--black);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  box-shadow: inset 1px 1px 0 var(--face-dark); background: var(--face);
}
.chip.active {
  background-image: repeating-linear-gradient(45deg, var(--face) 0, var(--face) 2px, var(--face-light) 2px, var(--face-light) 4px);
  font-weight: 700;
}

.command-preview {
  background: var(--lcd-bg); color: var(--lcd-fg); padding: 6px 8px;
  font-family: var(--lcd-font); font-size: 15px;
  border-top: 1px solid var(--black); border-left: 1px solid var(--black);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  box-shadow: inset 1px 1px 0 var(--face-dark); letter-spacing: 1px; margin-top: 8px;
}
.command-preview .cursor { animation: blink 1s step-end infinite; }
@keyframes blink { 50% { opacity: 0; } }

.button-row { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
.win-btn {
  background: var(--face);
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--black); border-bottom: 1px solid var(--black);
  box-shadow: inset -1px -1px 0 var(--face-dark), inset 1px 1px 0 var(--face-light);
  padding: 6px 20px; font-family: inherit; font-size: 11px;
  cursor: pointer; color: var(--text); min-width: 80px; min-height: 26px;
}
.win-btn:hover { background: var(--face-light); }
.win-btn:active, .win-btn.pressed {
  border-top: 1px solid var(--black); border-left: 1px solid var(--black);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  box-shadow: inset 1px 1px 0 var(--face-dark);
  padding: 7px 19px 5px 21px;
}
.win-btn.primary { font-weight: 700; outline: 1px dotted var(--black); outline-offset: -4px; }
.win-btn.large { padding: 10px 32px; font-size: 13px; min-width: 140px; }
.win-btn.large:active { padding: 11px 31px 9px 33px; }

.help-list { font-size: 11px; line-height: 1.7; }
.help-list p { margin: 2px 0; }
.help-list kbd {
  background: var(--face);
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--black); border-bottom: 1px solid var(--black);
  padding: 0 4px; font-family: var(--ui-font); font-size: 10px;
  display: inline-block; min-width: 16px; text-align: center;
}
.help-list b { color: var(--titlebar); }

/* Quiz */
.stats-panel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 10px; }
.stat-cell {
  background: var(--face);
  border-top: 1px solid var(--face-dark); border-left: 1px solid var(--face-dark);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  padding: 6px 8px; display: flex; flex-direction: column; gap: 4px;
}
.stat-cell label { font-size: 10px; color: var(--text); }
.stat-lcd {
  background: var(--lcd-bg); color: var(--lcd-fg); padding: 4px 8px;
  font-family: var(--lcd-font); font-size: 22px; text-align: right; letter-spacing: 1px;
  border-top: 1px solid var(--black); border-left: 1px solid var(--black);
  border-right: 1px solid var(--face-light); border-bottom: 1px solid var(--face-light);
}
.stat-lcd.pulse { animation: lcdPulse 0.4s ease; }
@keyframes lcdPulse {
  0%, 100% { color: var(--lcd-fg); }
  50% { color: #ff0; text-shadow: 0 0 6px #ff0; }
}
.stat-lcd .x { font-size: 15px; color: #060; }

.progress-container {
  height: 20px; background: var(--face);
  border-top: 1px solid var(--face-dark); border-left: 1px solid var(--face-dark);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  padding: 2px; margin-bottom: 12px; position: relative;
}
.progress-fill {
  height: 100%; width: 0%; transition: width 0.4s ease;
  background-image: repeating-linear-gradient(90deg, var(--titlebar) 0px, var(--titlebar) 12px, transparent 12px, transparent 14px);
}

.sub-window {
  background: var(--face);
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--black); border-bottom: 1px solid var(--black);
  box-shadow: inset -1px -1px 0 var(--face-dark), inset 1px 1px 0 var(--face-light);
  max-width: 440px; margin: 0 auto 14px;
}
.sub-titlebar {
  background: linear-gradient(90deg, var(--titlebar), var(--titlebar-2));
  color: var(--white); padding: 2px 3px 2px 5px;
  display: flex; align-items: center; justify-content: space-between;
  font-size: 10px; font-weight: 700;
}
.sub-content {
  background: #c0c0c0;
  background-image:
    linear-gradient(45deg, #808080 25%, transparent 25%),
    linear-gradient(-45deg, #808080 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #808080 75%),
    linear-gradient(-45deg, transparent 75%, #808080 75%);
  background-size: 12px 12px;
  background-position: 0 0, 0 6px, 6px -6px, -6px 0;
  padding: 12px; min-height: 200px;
  display: flex; align-items: center; justify-content: center;
  border-top: 1px solid var(--face-dark); border-left: 1px solid var(--face-dark);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  margin: 2px;
}
#flag-img {
  max-width: 100%; max-height: 240px; display: block;
  box-shadow: 2px 2px 0 rgba(0,0,0,0.4);
  animation: flagIn 0.35s ease;
  image-rendering: -webkit-optimize-contrast;
}
@keyframes flagIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
.flag-loading {
  color: var(--text); font-family: var(--lcd-font); font-size: 20px;
  background: var(--face); padding: 20px 32px; border: 1px solid var(--face-dark);
}
.flag-error {
  background: var(--face); padding: 16px 24px;
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--face-dark); border-bottom: 1px solid var(--face-dark);
  font-family: var(--ui-font); font-size: 11px;
  color: var(--text); text-align: center; max-width: 300px;
}
.flag-error .code {
  display: block; font-family: var(--pixel-font);
  font-size: 42px; color: var(--error-bg); margin: 8px 0;
  letter-spacing: 4px;
}
.flag-error .hint {
  font-size: 10px; color: var(--face-dark); margin-top: 8px;
}
.sub-statusbar {
  padding: 3px 6px; font-size: 10px; color: var(--text);
  border-top: 1px solid var(--face-dark); background: var(--face);
  font-family: var(--lcd-font); letter-spacing: 1px;
}

.input-panel {
  background: var(--face); padding: 10px;
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--face-dark); border-bottom: 1px solid var(--face-dark);
  margin-bottom: 10px; max-width: 520px; margin-left: auto; margin-right: auto;
}
.input-panel label { display: block; font-size: 11px; margin-bottom: 5px; font-weight: 700; }
.input-wrap { position: relative; }
.win-input {
  width: 100%; background: var(--input-bg);
  border-top: 1px solid var(--face-dark); border-left: 1px solid var(--face-dark);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  box-shadow: inset 1px 1px 0 var(--black), inset -1px -1px 0 var(--face-light);
  padding: 6px 8px; font-family: var(--ui-font); font-size: 14px;
  color: var(--text); outline: none;
}
.win-input:focus { background: #ffffe0; }
.win-input:disabled { background: var(--face); color: var(--disabled); }

.autocomplete {
  position: absolute; bottom: 100%; left: 0; right: 0; background: var(--white);
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--black); border-bottom: 1px solid var(--black);
  box-shadow: 2px 2px 6px rgba(0,0,0,0.3), inset -1px -1px 0 var(--face-dark);
  margin-bottom: 2px; max-height: 200px; overflow-y: auto;
  display: none; z-index: 20;
}
.autocomplete.open { display: block; }
.autocomplete-item {
  padding: 4px 10px; cursor: pointer; font-size: 12px; color: var(--text);
  display: flex; justify-content: space-between; align-items: center;
  border-bottom: 1px dotted #e0e0e0;
}
.autocomplete-item:last-child { border-bottom: none; }
.autocomplete-item .hint { color: var(--face-dark); font-size: 10px; }
.autocomplete-item.highlighted, .autocomplete-item:hover { background: var(--highlight); color: var(--white); }
.autocomplete-item.highlighted .hint, .autocomplete-item:hover .hint { color: #b0b0ff; }

.feedback {
  min-height: 24px; margin-top: 8px; padding: 4px 8px;
  text-align: center; font-size: 12px; font-weight: 700; letter-spacing: 1px;
  display: none; border: 1px solid transparent;
}
.feedback.success { display: block; background: var(--success-bg); color: var(--white); border-color: #004000; animation: fbIn 0.2s ease; }
.feedback.error { display: block; background: var(--error-bg); color: var(--white); border-color: #400000; animation: fbIn 0.2s ease; }
@keyframes fbIn { from { transform: scale(0.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }

.action-row { text-align: center; margin-bottom: 4px; }

/* End */
.result-window {
  background: var(--face);
  border-top: 1px solid var(--white); border-left: 1px solid var(--white);
  border-right: 1px solid var(--black); border-bottom: 1px solid var(--black);
  padding: 20px; text-align: center; margin-bottom: 12px;
  background-image: linear-gradient(180deg, #f5f5f5 0%, #c0c0c0 100%);
}
.big-score {
  font-family: var(--pixel-font); font-size: 72px; font-weight: 700;
  color: var(--titlebar); line-height: 1; text-shadow: 3px 3px 0 var(--gold);
  font-variant-numeric: tabular-nums;
}
.big-score .of { color: var(--face-dark); font-weight: 400; margin: 0 4px; }
.pct { font-family: var(--lcd-font); font-size: 26px; color: var(--text); margin-top: 4px; }
.verdict {
  font-family: var(--pixel-font); margin-top: 10px; font-size: 22px;
  color: var(--ember); letter-spacing: 2px; text-transform: uppercase;
}
.sub-stats {
  margin-top: 14px; font-size: 11px;
  display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; color: var(--text);
}
.sub-stats strong { color: var(--titlebar); margin-left: 4px; }

.mistakes-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
  gap: 6px; padding: 8px; background: var(--white);
  border-top: 1px solid var(--face-dark); border-left: 1px solid var(--face-dark);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  box-shadow: inset 1px 1px 0 var(--black);
  max-height: 320px; overflow-y: auto;
}
.mistake-card {
  border: 1px solid var(--face-dark); padding: 4px; text-align: center;
  background: var(--face); font-size: 10px;
}
.mistake-card img {
  width: 100%; aspect-ratio: 3/2; object-fit: cover;
  margin-bottom: 3px; display: block; background: #eee;
}
.mistake-card .mini-error {
  width: 100%; aspect-ratio: 3/2; background: #f8d7da; color: #721c24;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--pixel-font); font-weight: 700; font-size: 14px;
  margin-bottom: 3px; letter-spacing: 1px;
}
.mistake-card .country { color: var(--text); line-height: 1.2; }

.no-mistakes {
  background: var(--white); padding: 20px; text-align: center;
  font-family: var(--lcd-font); font-size: 20px; color: var(--success-bg);
  border-top: 1px solid var(--face-dark); border-left: 1px solid var(--face-dark);
  border-right: 1px solid var(--white); border-bottom: 1px solid var(--white);
  box-shadow: inset 1px 1px 0 var(--black);
}

.center-btns { display: flex; gap: 8px; justify-content: center; margin-top: 12px; flex-wrap: wrap; }

.pupvanh-footer {
  max-width: 780px;
  margin: 20px auto 8px;
  padding: 10px 12px;
  text-align: center;
  font-family: var(--lcd-font);
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  line-height: 1.7;
}
.pupvanh-footer .pv-line { display: block; }
.pupvanh-footer .pv-line.dim { color: rgba(255,255,255,0.5); font-size: 10px; margin-bottom: 2px; }
.pupvanh-footer .pv-name { color: var(--gold); font-weight: 700; }
.pupvanh-footer a { color: rgba(255,255,255,0.75); text-decoration: none; border-bottom: 1px dotted rgba(255,255,255,0.35); }
.pupvanh-footer a:hover { color: var(--gold); border-bottom-color: var(--gold); }
html[data-theme="classroom"] .pupvanh-footer {
  color: #4a3220;
  font-family: 'Kalam', cursive;
  text-transform: none;
  letter-spacing: 0.5px;
  font-size: 13px;
}
html[data-theme="classroom"] .pupvanh-footer .pv-line.dim { color: rgba(74,50,32,0.55); font-size: 11px; }
html[data-theme="classroom"] .pupvanh-footer .pv-name { color: #8b5e3c; font-weight: 700; }
html[data-theme="classroom"] .pupvanh-footer a { color: #4a3220; border-bottom: 1px dotted rgba(74,50,32,0.4); }
html[data-theme="classroom"] .pupvanh-footer a:hover { color: #8b5e3c; border-bottom-color: #8b5e3c; }

/* Setup warning banner if flags folder missing */
.setup-warning {
  background: #fff3cd; border: 1px solid #d4b400;
  padding: 10px 12px; margin-bottom: 12px; font-size: 12px; color: #856404;
}
.setup-warning strong { color: #4a3700; }
.setup-warning code {
  background: rgba(0,0,0,0.08); padding: 1px 5px; font-family: monospace; font-size: 11px;
}

/* ================================================================
   ================== CLASSROOM THEME OVERRIDES ==================
   ================================================================ */

/* Extra fonts voor klaslokaal */
html[data-theme="classroom"] {
  --classroom-wall: #d9c9a3;
  --classroom-wall-2: #c4b28a;
  --classroom-wood: #8b5e3c;
  --classroom-wood-dark: #4a3220;
  --classroom-wood-light: #a67846;
  --classroom-board: #2d4a3e;
  --classroom-board-dark: #1e3a30;
  --classroom-chalk: #f5efe0;
  --classroom-chalk-dim: rgba(245,239,224,0.65);
  --classroom-chalk-yellow: #f4d97a;
  --classroom-chalk-pink: #f4a3c0;
  --classroom-chalk-red: #ff6b6b;
  --classroom-chalk-green: #a8e063;
  --hand-font: "Kalam", "Comic Sans MS", cursive;
  --big-hand-font: "Caveat", cursive;
}

/* Body: klaslokaal muur */
html[data-theme="classroom"] body {
  background:
    linear-gradient(180deg, transparent 0%, transparent 70%, rgba(74,50,32,0.15) 100%),
    radial-gradient(ellipse at top, var(--classroom-wall) 0%, var(--classroom-wall-2) 100%);
  background-image:
    radial-gradient(circle at 1px 1px, rgba(74,50,32,0.08) 1px, transparent 0),
    linear-gradient(180deg, var(--classroom-wall) 0%, var(--classroom-wall-2) 100%);
  background-size: 24px 24px, 100% 100%;
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
}

/* Terminal container → krijtbord met houten frame */
html[data-theme="classroom"] .win {
  background:
    radial-gradient(ellipse at 25% 30%, rgba(255,255,255,0.04) 0%, transparent 55%),
    radial-gradient(ellipse at 75% 65%, rgba(255,255,255,0.03) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 90%, rgba(255,255,255,0.02) 0%, transparent 60%),
    linear-gradient(135deg, var(--classroom-board) 0%, var(--classroom-board-dark) 100%);
  border: 12px solid var(--classroom-wood);
  border-image: linear-gradient(135deg, var(--classroom-wood-light) 0%, var(--classroom-wood-dark) 50%, var(--classroom-wood) 100%) 1;
  box-shadow:
    0 12px 40px rgba(0,0,0,0.4),
    inset 0 0 80px rgba(0,0,0,0.4),
    inset 0 0 4px rgba(255,255,255,0.05);
  padding: 0;
}

/* Titlebar → houten plank bovenaan het bord */
html[data-theme="classroom"] .titlebar {
  background:
    linear-gradient(180deg, var(--classroom-wood-light) 0%, var(--classroom-wood) 50%, var(--classroom-wood-dark) 100%);
  color: var(--classroom-chalk);
  font-family: var(--big-hand-font);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.5px;
  height: 28px;
  padding: 4px 8px 4px 12px;
  border-bottom: 2px solid var(--classroom-wood-dark);
}
html[data-theme="classroom"] .titlebar-btn {
  background: rgba(0,0,0,0.15);
  border: 1px solid rgba(0,0,0,0.3);
  box-shadow: none;
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
}

/* Menubar op de bovenkant van het bord */
html[data-theme="classroom"] .menubar {
  background: rgba(0,0,0,0.2);
  border-bottom: 1px dashed rgba(245,239,224,0.2);
  color: var(--classroom-chalk-dim);
}
html[data-theme="classroom"] .menu-item {
  color: var(--classroom-chalk-dim);
  font-family: var(--hand-font);
  font-size: 13px;
}
html[data-theme="classroom"] .menu-item:hover:not(.no-hover) {
  background: rgba(245,239,224,0.15);
  color: var(--classroom-chalk);
}
html[data-theme="classroom"] .lang-btn,
html[data-theme="classroom"] .theme-btn {
  color: var(--classroom-chalk-dim);
  font-family: var(--hand-font);
  font-size: 14px;
}
html[data-theme="classroom"] .lang-btn.active {
  background: transparent;
  color: var(--classroom-chalk-yellow);
  text-decoration: underline;
  font-weight: 700;
}
html[data-theme="classroom"] .theme-btn {
  font-size: 16px;
  padding: 2px 6px;
}
html[data-theme="classroom"] .theme-btn.active {
  background: rgba(245,217,122,0.2);
  border-radius: 4px;
}
html[data-theme="classroom"] .lang-switch .sep,
html[data-theme="classroom"] .theme-switch .sep {
  color: rgba(245,239,224,0.3);
}

/* Alle statusbar cells */
html[data-theme="classroom"] .statusbar {
  border-top: 1px dashed rgba(245,239,224,0.2);
}
html[data-theme="classroom"] .statusbar-cell {
  background: rgba(0,0,0,0.15);
  border-color: rgba(245,239,224,0.15);
  color: var(--classroom-chalk-dim);
  font-family: var(--hand-font);
}

/* SETUP — brand block wordt "welkom" krijtbord notitie */
html[data-theme="classroom"] .brand-block {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 20px 12px 4px;
  background-image: none;
}
html[data-theme="classroom"] .brand {
  font-family: var(--big-hand-font);
  font-size: 96px;
  font-weight: 700;
  color: var(--classroom-chalk);
  text-shadow:
    2px 2px 0 rgba(0,0,0,0.4),
    0 0 12px rgba(245,239,224,0.15);
  letter-spacing: 2px;
  transform: rotate(-1.5deg);
}
html[data-theme="classroom"] .brand.small { font-size: 72px; }
html[data-theme="classroom"] .tagline {
  font-family: var(--hand-font);
  font-size: 20px;
  color: var(--classroom-chalk-dim);
  letter-spacing: 0.5px;
  transform: rotate(0.5deg);
}

/* Dialog groepen worden krijt-notities */
html[data-theme="classroom"] .dialog-group {
  background: rgba(0,0,0,0.12);
  border: 1px dashed rgba(245,239,224,0.35);
  box-shadow: none;
  padding: 16px;
}
html[data-theme="classroom"] .dialog-title {
  color: var(--classroom-chalk-yellow);
  font-family: var(--big-hand-font);
  font-size: 18px;
  border-bottom: 1px dashed rgba(245,239,224,0.25);
  box-shadow: none;
  padding-bottom: 8px;
}
html[data-theme="classroom"] .dialog-title::before {
  background: var(--classroom-chalk-yellow);
  border-radius: 50%;
  width: 10px;
  height: 10px;
}

/* Fieldsets */
html[data-theme="classroom"] fieldset {
  border: 1px dashed rgba(245,239,224,0.3);
  box-shadow: none;
  background: rgba(0,0,0,0.1);
}
html[data-theme="classroom"] fieldset legend {
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
  font-size: 14px;
  background: var(--classroom-board);
  padding: 0 8px;
}

/* Radio row + labels */
html[data-theme="classroom"] .radio-row label {
  color: var(--classroom-chalk);
  font-size: 15px;
  font-family: var(--hand-font);
}
html[data-theme="classroom"] .radio-row input[type=radio] {
  accent-color: var(--classroom-chalk-yellow);
}

/* Chips → krijt tags */
html[data-theme="classroom"] .chip {
  background: transparent;
  border: 1px dashed rgba(245,239,224,0.4);
  box-shadow: none;
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
  font-size: 14px;
  border-radius: 20px;
}
html[data-theme="classroom"] .chip:hover {
  background: rgba(245,239,224,0.08);
  border-color: var(--classroom-chalk);
}
html[data-theme="classroom"] .chip.active {
  background: var(--classroom-chalk-yellow);
  color: var(--classroom-board-dark);
  border: 2px solid var(--classroom-chalk-yellow);
  background-image: none;
  box-shadow: 2px 2px 0 rgba(0,0,0,0.2);
}

/* Command preview → krijt notitie */
html[data-theme="classroom"] .command-preview {
  background: rgba(0,0,0,0.25);
  color: var(--classroom-chalk-green);
  border: 1px dashed rgba(245,239,224,0.2);
  box-shadow: none;
  font-family: var(--hand-font);
  font-size: 15px;
  letter-spacing: 0;
}

/* Primary btn → gele krijt-badge */
html[data-theme="classroom"] .primary-btn,
html[data-theme="classroom"] .win-btn.primary {
  background: var(--classroom-chalk-yellow);
  color: var(--classroom-board-dark);
  border: 2px solid var(--classroom-chalk-yellow);
  box-shadow: 3px 3px 0 rgba(0,0,0,0.3);
  font-family: var(--big-hand-font);
  font-size: 20px;
  letter-spacing: 1px;
  text-transform: none;
  outline: none;
  transition: transform 0.1s;
}
html[data-theme="classroom"] .primary-btn:hover,
html[data-theme="classroom"] .win-btn.primary:hover {
  background: #ffe488;
  box-shadow: 4px 4px 0 rgba(0,0,0,0.35);
  transform: translate(-1px, -1px);
}
html[data-theme="classroom"] .win-btn {
  background: transparent;
  border: 1px dashed rgba(245,239,224,0.4);
  box-shadow: none;
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
  font-size: 15px;
}
html[data-theme="classroom"] .win-btn:hover {
  background: rgba(245,239,224,0.1);
  border-color: var(--classroom-chalk);
}
html[data-theme="classroom"] .win-btn:active {
  transform: translate(1px, 1px);
  padding: 6px 20px;
}

/* Help list */
html[data-theme="classroom"] .help-list {
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
  font-size: 15px;
}
html[data-theme="classroom"] .help-list b {
  color: var(--classroom-chalk-yellow);
}
html[data-theme="classroom"] .help-list kbd {
  background: rgba(245,239,224,0.1);
  border: 1px dashed rgba(245,239,224,0.4);
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
  border-radius: 3px;
  box-shadow: none;
}

/* Setup warning */
html[data-theme="classroom"] .setup-warning {
  background: rgba(244,163,192,0.15);
  border: 1px dashed var(--classroom-chalk-pink);
  color: var(--classroom-chalk-pink);
  font-family: var(--hand-font);
}
html[data-theme="classroom"] .setup-warning strong {
  color: var(--classroom-chalk-red);
}

/* QUIZ — stats panel wordt krijt-cijfers */
html[data-theme="classroom"] .stats-panel {
  border: 1px dashed rgba(245,239,224,0.3);
  background: rgba(0,0,0,0.15);
  padding: 12px;
  border-radius: 4px;
}
html[data-theme="classroom"] .stat-cell {
  background: transparent;
  border: none;
  padding: 4px 8px;
}
html[data-theme="classroom"] .stat-cell label {
  color: var(--classroom-chalk-dim);
  font-family: var(--hand-font);
  font-size: 12px;
  text-transform: none;
  letter-spacing: 0;
}
html[data-theme="classroom"] .stat-lcd {
  background: transparent;
  color: var(--classroom-chalk-yellow);
  border: none;
  font-family: var(--big-hand-font);
  font-size: 30px;
  text-align: center;
  padding: 0;
  text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
}
html[data-theme="classroom"] .stat-lcd .x {
  color: var(--classroom-chalk-dim);
  font-size: 22px;
}

/* Progress bar → krijt streep */
html[data-theme="classroom"] .progress-container {
  background: rgba(0,0,0,0.2);
  border: 1px dashed rgba(245,239,224,0.2);
  border-radius: 8px;
  height: 12px;
  padding: 2px;
}
html[data-theme="classroom"] .progress-fill {
  background: var(--classroom-chalk-yellow);
  background-image: none;
  box-shadow: 0 0 8px rgba(244,217,122,0.5);
  border-radius: 4px;
}

/* Flag frame → geen dubbele omkadering, staat gewoon op het bord */
html[data-theme="classroom"] .sub-window {
  background: transparent;
  border: none;
  box-shadow: none;
  max-width: 480px;
}
html[data-theme="classroom"] .sub-titlebar {
  background: transparent;
  color: var(--classroom-chalk-dim);
  font-family: var(--hand-font);
  font-size: 12px;
  text-align: center;
  justify-content: center;
  padding: 4px;
}
html[data-theme="classroom"] .sub-titlebar .titlebar-controls { display: none; }
html[data-theme="classroom"] .sub-content {
  background: transparent;
  background-image: none;
  border: 3px dashed rgba(245,239,224,0.3);
  margin: 0;
  padding: 16px;
  border-radius: 4px;
}
html[data-theme="classroom"] #flag-img {
  box-shadow: 0 4px 16px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,0,0,0.3);
  background: white;
  padding: 2px;
}
html[data-theme="classroom"] .sub-statusbar {
  background: transparent;
  color: var(--classroom-chalk-dim);
  font-family: var(--hand-font);
  font-size: 11px;
  border-top: 1px dashed rgba(245,239,224,0.15);
  text-align: center;
}
html[data-theme="classroom"] .flag-loading {
  background: transparent;
  border: 1px dashed rgba(245,239,224,0.3);
  color: var(--classroom-chalk-dim);
  font-family: var(--hand-font);
  font-size: 22px;
}
html[data-theme="classroom"] .flag-error {
  background: rgba(255,107,107,0.15);
  border: 1px dashed var(--classroom-chalk-red);
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
}
html[data-theme="classroom"] .flag-error .code {
  color: var(--classroom-chalk-red);
  font-family: var(--big-hand-font);
}

/* Input panel → notitieboekje style */
html[data-theme="classroom"] .input-panel {
  background: rgba(245,239,224,0.06);
  border: 1px dashed rgba(245,239,224,0.3);
  border-radius: 4px;
}
html[data-theme="classroom"] .input-panel label {
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
  font-size: 14px;
  font-weight: 400;
}
html[data-theme="classroom"] .win-input {
  background: rgba(245,239,224,0.9);
  color: var(--classroom-board-dark);
  border: none;
  border-bottom: 2px solid var(--classroom-chalk-yellow);
  box-shadow: none;
  font-family: var(--hand-font);
  font-size: 18px;
  padding: 8px 10px;
}
html[data-theme="classroom"] .win-input:focus {
  background: var(--classroom-chalk);
}

/* Autocomplete → gele post-it stapel */
html[data-theme="classroom"] .autocomplete {
  background: #fff9db;
  border: none;
  box-shadow: 3px 3px 12px rgba(0,0,0,0.4);
}
html[data-theme="classroom"] .autocomplete-item {
  color: var(--classroom-board-dark);
  font-family: var(--hand-font);
  font-size: 16px;
  border-bottom: 1px dashed rgba(74,50,32,0.2);
}
html[data-theme="classroom"] .autocomplete-item.highlighted,
html[data-theme="classroom"] .autocomplete-item:hover {
  background: var(--classroom-chalk-yellow);
  color: var(--classroom-board-dark);
}

/* Feedback → krijt ✓ of ✗ */
html[data-theme="classroom"] .feedback {
  border: 2px dashed transparent;
  border-radius: 4px;
  font-family: var(--big-hand-font);
  font-size: 20px;
  letter-spacing: 0;
  text-transform: none;
}
html[data-theme="classroom"] .feedback.success {
  background: transparent;
  color: var(--classroom-chalk-green);
  border-color: var(--classroom-chalk-green);
}
html[data-theme="classroom"] .feedback.error {
  background: transparent;
  color: var(--classroom-chalk-red);
  border-color: var(--classroom-chalk-red);
}

/* END — result screen */
html[data-theme="classroom"] .result-window {
  background: rgba(0,0,0,0.15);
  border: 1px dashed rgba(245,239,224,0.4);
  background-image: none;
}
html[data-theme="classroom"] .big-score {
  font-family: var(--big-hand-font);
  color: var(--classroom-chalk-yellow);
  text-shadow: 3px 3px 0 rgba(0,0,0,0.3);
  font-size: 100px;
}
html[data-theme="classroom"] .big-score .of {
  color: var(--classroom-chalk-dim);
}
html[data-theme="classroom"] .pct {
  font-family: var(--hand-font);
  color: var(--classroom-chalk);
  letter-spacing: 0;
}
html[data-theme="classroom"] .verdict {
  font-family: var(--big-hand-font);
  color: var(--classroom-chalk-yellow);
  text-transform: none;
  letter-spacing: 1px;
}
html[data-theme="classroom"] .sub-stats {
  color: var(--classroom-chalk-dim);
  font-family: var(--hand-font);
  text-transform: none;
  letter-spacing: 0;
  font-size: 14px;
}
html[data-theme="classroom"] .sub-stats strong {
  color: var(--classroom-chalk-yellow);
}
html[data-theme="classroom"] .review-title {
  color: var(--classroom-chalk);
  font-family: var(--hand-font);
  font-size: 14px;
}
html[data-theme="classroom"] .mistakes-grid {
  background: rgba(0,0,0,0.15);
  border: 1px dashed rgba(245,239,224,0.3);
  box-shadow: none;
  padding: 10px;
}
html[data-theme="classroom"] .mistake-card {
  background: rgba(245,239,224,0.08);
  border: 1px dashed rgba(245,239,224,0.3);
  color: var(--classroom-chalk);
}
html[data-theme="classroom"] .mistake-card .country {
  color: var(--classroom-chalk-yellow);
  font-family: var(--hand-font);
  font-size: 12px;
}
html[data-theme="classroom"] .no-mistakes {
  background: transparent;
  border: 1px dashed var(--classroom-chalk-green);
  color: var(--classroom-chalk-green);
  font-family: var(--big-hand-font);
  font-size: 22px;
  box-shadow: none;
}



/* De leerkracht cartoon */
.teacher-img {
  display: none;
  position: fixed;
  bottom: 0;
  right: 20px;
  height: 85vh;
  max-height: 750px;
  z-index: 30;
  pointer-events: none;
  transform: scaleX(-1);
  filter: drop-shadow(-8px 8px 20px rgba(0,0,0,0.25));
  animation: teacherBob 4s ease-in-out infinite;
}
@keyframes teacherBob {
  0%, 100% { transform: scaleX(-1) translateY(0); }
  50% { transform: scaleX(-1) translateY(-6px); }
}
html[data-theme="classroom"] .teacher-img {
  display: block;
}

@media (max-width: 1100px) {
  html[data-theme="classroom"] .teacher-img {
    height: 60vh;
    right: -30px;
    opacity: 0.85;
  }
}
@media (max-width: 800px) {
  html[data-theme="classroom"] .teacher-img { display: none; }
}
@media (max-width: 640px) {
  html[data-theme="classroom"] .brand { font-size: 68px; }
  html[data-theme="classroom"] .brand.small { font-size: 52px; }
  html[data-theme="classroom"] .stat-lcd { font-size: 22px; }
  html[data-theme="classroom"] .big-score { font-size: 68px; }
}



/* ============ ECHT KLASLOKAAL (posters + plinth + klok + krijthouder) ============ */

/* Houten plint onderaan */
.classroom-plinth {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 60px;
  background: linear-gradient(180deg, #8b5e3c 0%, #6d4c2e 40%, #4a3220 70%, #2a1c10 100%);
  border-top: 2px solid #4a3220;
  box-shadow: 0 -4px 12px rgba(74,50,32,0.35);
  z-index: 5;
  pointer-events: none;
}
.classroom-plinth::before {
  content: '';
  position: absolute;
  top: 8px; left: 0; right: 0;
  height: 2px;
  background: rgba(255,255,255,0.08);
}
html[data-theme="classroom"] .classroom-plinth { display: block; }

/* Pull-down landkaarten aan de muur */
.classroom-decor {
  display: none;
  position: fixed;
  z-index: 15;
  pointer-events: none;
}
html[data-theme="classroom"] .classroom-decor { display: block; }
.classroom-decor.left {
  top: 0;
  left: 0;
  width: 470px;
  height: 100vh;
  pointer-events: none;
}

.wall-map {
  position: absolute;
  display: block;
  filter: drop-shadow(3px 6px 14px rgba(0,0,0,0.4));
}
.wall-map.aus     { top: 5px;   left: 15px;  width: 195px; transform: rotate(-2deg); }
.wall-map.belgium { top: 20px;  left: 235px; width: 170px; transform: rotate(3deg); }
.wall-map.usa     { top: 235px; left: 5px;   width: 225px; transform: rotate(-1deg); z-index: 2; }
.wall-map.kiribati{ top: 250px; left: 250px; width: 185px; transform: rotate(2deg); }
.wall-map.nz      { top: 460px; left: 90px;  width: 170px; transform: rotate(-3deg); z-index: 3; }

/* Kleine klok bovenaan */
.classroom-clock {
  display: none;
  position: fixed;
  top: 20px; left: 50%;
  transform: translateX(-50%);
  width: 56px; height: 56px;
  background: radial-gradient(circle at 30% 30%, #ffffff 0%, #f0eae0 100%);
  border-radius: 50%;
  border: 5px solid #4a3220;
  box-shadow: 3px 4px 12px rgba(0,0,0,0.35), inset 0 0 6px rgba(0,0,0,0.15);
  z-index: 20;
}
html[data-theme="classroom"] .classroom-clock { display: block; }
.classroom-clock::before, .classroom-clock::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  background: #2c2620;
  transform-origin: 0 0;
}
.classroom-clock::before { width: 15px; height: 3px; transform: rotate(-70deg); border-radius: 2px; }
.classroom-clock::after { width: 22px; height: 2px; transform: rotate(20deg); border-radius: 2px; }
.classroom-clock .center {
  position: absolute;
  top: 50%; left: 50%;
  width: 6px; height: 6px;
  background: #4a3220;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

/* Krijthouder onder het bord */
.chalk-tray {
  display: none;
  position: absolute;
  bottom: -14px;
  left: 8%; right: 8%;
  height: 18px;
  background: linear-gradient(180deg, #a67846 0%, #6d4c2e 60%, #3a2510 100%);
  border: 1px solid #2c1a08;
  border-top: none;
  border-radius: 0 0 6px 6px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.3);
  z-index: 5;
  padding: 2px 20px;
}
html[data-theme="classroom"] .chalk-tray { display: flex; align-items: center; gap: 14px; }
.chalk-piece { height: 8px; border-radius: 2px; box-shadow: 0 1px 1px rgba(0,0,0,0.25); }
.chalk-piece.a { width: 32px; background: #f5efe0; }
.chalk-piece.b { width: 22px; background: #ffe488; margin-left: auto; }
.chalk-piece.c { width: 26px; background: #f4a3c0; }
.eraser {
  width: 40px; height: 12px;
  background: linear-gradient(180deg, #dd3333 0%, #aa2222 100%);
  border-radius: 3px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.3), inset 0 -3px 0 #f0e6d0;
  margin-left: 8px;
}
html[data-theme="classroom"] .win { position: relative; }

@media (max-width: 1400px) {
  .classroom-decor.left { width: 380px; }
  .wall-map.aus     { top: 5px;   left: 15px;  width: 170px; }
  .wall-map.belgium { top: 15px;  left: 210px; width: 145px; }
  .wall-map.usa     { top: 200px; left: 5px;   width: 200px; }
  .wall-map.kiribati{ top: 220px; left: 220px; width: 155px; }
  .wall-map.nz      { top: 400px; left: 70px;  width: 145px; }
}
@media (max-width: 1200px) {
  .classroom-decor.left { width: 300px; }
  .wall-map.belgium, .wall-map.kiribati { display: none; }
  .wall-map.aus     { top: 5px;   left: 10px; width: 175px; }
  .wall-map.usa     { top: 195px; left: 5px;  width: 210px; }
  .wall-map.nz      { top: 400px; left: 60px; width: 145px; }
}
@media (max-width: 1000px) {
  .wall-map.nz { display: none; }
  .wall-map.aus { top: 10px; left: 5px; width: 155px; }
  .wall-map.usa { top: 175px; left: 0; width: 185px; }
}
@media (max-width: 900px) {
  .classroom-decor, .classroom-clock, .classroom-plinth { display: none !important; }
}

/* Origineel retro responsive - moet ONDER classroom komen zodat het voor retro werkt */
@media (max-width: 640px) {
  body { padding: 10px 6px; font-size: 12px; }
  html:not([data-theme="classroom"]) .brand { font-size: 52px; text-shadow: 2px 2px 0 var(--gold), 4px 4px 0 var(--face-dark); }
  html:not([data-theme="classroom"]) .tagline { font-size: 15px; }
  .window-body { padding: 8px; }
  .stats-panel { gap: 4px; }
  .stat-cell { padding: 4px 6px; }
  html:not([data-theme="classroom"]) .stat-cell label { font-size: 9px; }
  html:not([data-theme="classroom"]) .stat-lcd { font-size: 17px; padding: 3px 6px; }
  .brand-block { padding: 12px 8px 10px; }
  .win-btn.large { padding: 8px 20px; font-size: 12px; min-width: 100px; }
  html:not([data-theme="classroom"]) .big-score { font-size: 52px; text-shadow: 2px 2px 0 var(--gold); }
  .win-input { font-size: 15px; }
  .radio-row { gap: 12px; }
  .chip { min-width: 60px; padding: 4px 8px; }
  fieldset { padding: 8px 10px; }
  html:not([data-theme="classroom"]) .command-preview { font-size: 13px; }
}


/* ============ WANDDECOR (klaslokaal thema) ============ */
.classroom-bunting, .classroom-calendar,
.classroom-plant, .classroom-globe, .classroom-books {
  display: none;
  position: fixed;
  z-index: 12;
  pointer-events: none;
}
html[data-theme="classroom"] .classroom-bunting,
html[data-theme="classroom"] .classroom-calendar,
html[data-theme="classroom"] .classroom-plant,
html[data-theme="classroom"] .classroom-globe,
html[data-theme="classroom"] .classroom-books { display: block; }

/* Vlaggenslinger bovenaan */
.classroom-bunting {
  top: 0; left: 0; right: 0;
  height: 60px;
  z-index: 22;
}
.classroom-bunting svg { width: 100%; height: 100%; display: block; }

/* Kalender rechts bovenaan (boven leerkracht) */
.classroom-calendar {
  top: 50px;
  right: 30px;
  width: 105px;
  z-index: 18;
  filter: drop-shadow(2px 3px 8px rgba(0,0,0,0.35));
}
.classroom-calendar svg { width: 100%; height: auto; display: block; }

/* Plant links onderaan bij plint */
.classroom-plant {
  bottom: 45px;
  left: 24px;
  width: 78px;
  z-index: 14;
  filter: drop-shadow(2px 3px 6px rgba(0,0,0,0.3));
}
.classroom-plant svg { width: 100%; height: auto; display: block; }

/* Wereldbol midden onderaan */
.classroom-globe {
  bottom: 45px;
  left: 50%;
  transform: translateX(-50%);
  width: 62px;
  z-index: 14;
  filter: drop-shadow(2px 3px 6px rgba(0,0,0,0.3));
}
.classroom-globe svg { width: 100%; height: auto; display: block; }

/* Boekenstapel iets naast de wereldbol */
.classroom-books {
  bottom: 45px;
  left: calc(50% + 60px);
  width: 90px;
  z-index: 14;
  filter: drop-shadow(2px 3px 6px rgba(0,0,0,0.3));
}
.classroom-books svg { width: 100%; height: auto; display: block; }

/* Responsive: op smaller schermen, decor verstoppen dat conflicteert */
@media (max-width: 1100px) {
  .classroom-calendar { top: 40px; right: 10px; width: 90px; }
}
@media (max-width: 900px) {
  .classroom-calendar, .classroom-globe, .classroom-books { display: none !important; }
  .classroom-plant { width: 60px; left: 8px; }
  .classroom-bunting { height: 45px; }
}
@media (max-width: 640px) {
  .classroom-bunting, .classroom-plant { display: none !important; }
}

</style>
</head>
