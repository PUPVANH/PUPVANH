// ============ STATE ============
let state = {
  lang: 'nl', count: 25, region: 'all',
  pool: [], currentIdx: 0, score: 0, streak: 0, bestStreak: 0,
  mistakes: [], suggestions: [], highlighted: -1, answered: false,
};

// ============ HELPERS ============
function normalize(s) {
  return (s || '').toString().toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[-'.]/g, ' ').replace(/\s+/g, ' ').trim();
}
function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
function pool() {
  if (state.region === 'all') return COUNTRIES;
  return COUNTRIES.filter(c => c.region === state.region);
}
function getContinent(c) {
  if (CONTINENT_OVERRIDES[c.code]) return CONTINENT_OVERRIDES[c.code];
  // 5 filter-regio's mappen naar 6 continent-folders (americas → North/South)
  if (c.region === 'americas') {
    return SOUTH_AMERICA_CODES.has(c.code) ? 'South_America' : 'North_America';
  }
  return c.region.charAt(0).toUpperCase() + c.region.slice(1);
}
function getFilename(c) {
  if (FILENAME_OVERRIDES[c.code]) return FILENAME_OVERRIDES[c.code];
  // Engelse naam → spaties én streepjes naar underscores, apostrof weg
  return c.en.replace(/[ \-]/g, '_').replace(/'/g, '');
}
function flagUrl(c) {
  // Als er een string binnenkomt (oude aanroepen), zoek het land op via de code
  if (typeof c === 'string') {
    c = COUNTRIES.find(x => x.code === c);
    if (!c) return '';
  }
  return `${FLAGS_PATH}${getContinent(c)}/${FLAGS_FORMAT}/${getFilename(c)}${FLAGS_EXT}`;
}

// ============ LANG ============
function initLang() {
  const saved = localStorage.getItem('flags-lang');
  if (saved && (saved === 'nl' || saved === 'en')) state.lang = saved;
  else if (navigator.language && !navigator.language.toLowerCase().startsWith('nl')) state.lang = 'en';
  applyLang();
}
function applyLang() {
  document.documentElement.lang = state.lang;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.dataset.i18n;
    if (i18n[state.lang][key] !== undefined) el.innerHTML = i18n[state.lang][key];
  });
  document.querySelectorAll('.lang-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.lang === state.lang);
  });
  const input = document.getElementById('answer-input');
  if (input) input.placeholder = i18n[state.lang].placeholder;
  const pvPartof = document.getElementById('pv-partof');
  if (pvPartof) pvPartof.textContent = i18n[state.lang].footer_partof;
  updateRegionDisplay();
  localStorage.setItem('flags-lang', state.lang);
  setStatus(getScreen() === 'quiz' ? i18n[state.lang].status_playing
          : getScreen() === 'end' ? i18n[state.lang].status_done
          : i18n[state.lang].status_ready);
  document.getElementById('status-region').textContent = i18n[state.lang]['reg_' + state.region] || state.region;
}
function updateRegionDisplay() {
  const key = 'reg_' + state.region;
  document.getElementById('region-display').textContent = (i18n[state.lang][key] || state.region).toLowerCase();
  document.getElementById('status-region').textContent = i18n[state.lang][key] || state.region;
}
function setStatus(txt) { document.getElementById('status-text').textContent = txt; }
function setWinTitle(k) { document.getElementById('win-title').textContent = i18n[state.lang][k]; }

// ============ SCREENS ============
function getScreen() { const s = document.querySelector('.screen.active'); return s ? s.id : 'setup'; }
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if (id === 'quiz') { setStatus(i18n[state.lang].status_playing); setWinTitle('win_title'); }
  else if (id === 'end') { setStatus(i18n[state.lang].status_done); setWinTitle('win_title_result'); }
  else { setStatus(i18n[state.lang].status_ready); setWinTitle('win_title'); }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ============ FOLDER CHECK ============
function checkFlagsFolder() {
  const testCountry = COUNTRIES.find(c => c.code === 'be');
  const img = new Image();
  img.onload = () => { document.getElementById('folder-check').style.display = 'none'; };
  img.onerror = () => { document.getElementById('folder-check').style.display = 'block'; };
  img.src = flagUrl(testCountry);
}

// ============ QUIZ ============
function startQuiz() {
  const available = pool();
  const actualCount = Math.min(state.count, available.length);
  state.pool = shuffle(available).slice(0, actualCount);
  state.currentIdx = 0;
  state.score = 0;
  state.streak = 0;
  state.bestStreak = 0;
  state.mistakes = [];
  document.getElementById('total').textContent = actualCount;
  showScreen('quiz');
  loadCurrent();
}

function setFlagImage(country) {
  const container = document.getElementById('flag-content');
  container.innerHTML = '<div class="flag-loading">LOADING...</div>';
  const info = document.getElementById('flag-info');
  info.textContent = 'loading...';
  const filename = getFilename(country);
  document.getElementById('sub-title').textContent = 'Flag_Preview.svg';

  const url = flagUrl(country);
  const img = new Image();
  img.onload = () => {
    container.innerHTML = '';
    img.alt = country[state.lang];
    img.id = 'flag-img';
    container.appendChild(img);
    info.textContent = 'flag loaded · guess it';
  };
  img.onerror = () => {
    container.innerHTML = `
      <div class="flag-error">
        ⚠ ${i18n[state.lang].flag_missing}
        <span class="code">${country.code.toUpperCase()}</span>
        <div class="hint">${i18n[state.lang].flag_hint}<br><code>${url}</code></div>
      </div>`;
    info.textContent = 'file not found';
  };
  img.src = url;
}

function loadCurrent() {
  const c = state.pool[state.currentIdx];
  setFlagImage(c);
  updateStats();
  const input = document.getElementById('answer-input');
  input.value = ''; input.disabled = false; input.focus();
  clearFeedback(); hideAutocomplete();
  state.answered = false;
}

function updateStats() {
  document.getElementById('score').textContent = state.score;
  document.getElementById('streak-value').textContent = state.streak;
  document.getElementById('remaining').textContent = state.pool.length - state.currentIdx;
  const pct = (state.currentIdx / state.pool.length) * 100;
  document.getElementById('progress').style.width = pct + '%';
}

function submitAnswer(answer, isSkip = false) {
  if (state.answered) return;
  state.answered = true;
  const c = state.pool[state.currentIdx];
  const correctName = c[state.lang];
  const isCorrect = !isSkip && normalize(answer) === normalize(correctName);
  const input = document.getElementById('answer-input');
  input.disabled = true;
  hideAutocomplete();

  if (isCorrect) {
    state.score++; state.streak++;
    state.bestStreak = Math.max(state.bestStreak, state.streak);
    showFeedback(i18n[state.lang].correct, 'success');
    const lcd = document.getElementById('streak-lcd');
    lcd.classList.remove('pulse'); void lcd.offsetWidth; lcd.classList.add('pulse');
  } else {
    state.streak = 0;
    state.mistakes.push({ ...c, answered: answer });
    const label = isSkip ? i18n[state.lang].skipped : i18n[state.lang].wrong;
    showFeedback(`${label} ${correctName.toUpperCase()}`, 'error');
    input.value = correctName;
  }

  updateStats();
  setTimeout(() => {
    state.currentIdx++;
    if (state.currentIdx >= state.pool.length) endQuiz();
    else loadCurrent();
  }, isCorrect ? 650 : 1600);
}

function skip() { if (!state.answered) submitAnswer('', true); }
function showFeedback(text, type) { const f = document.getElementById('feedback'); f.textContent = text; f.className = 'feedback ' + type; }
function clearFeedback() { const f = document.getElementById('feedback'); f.textContent = ''; f.className = 'feedback'; }

// ============ AUTOCOMPLETE ============
function updateSuggestions() {
  const input = document.getElementById('answer-input');
  const val = normalize(input.value);
  if (!val) { hideAutocomplete(); return; }
  const matches = COUNTRIES
    .map(c => ({ c, name: c[state.lang], norm: normalize(c[state.lang]) }))
    .filter(x => x.norm.includes(val))
    .sort((a, b) => {
      const av = a.norm.startsWith(val) ? 0 : 1;
      const bv = b.norm.startsWith(val) ? 0 : 1;
      return av - bv || a.name.localeCompare(b.name);
    })
    .slice(0, 7);
  state.suggestions = matches;
  state.highlighted = matches.length > 0 ? 0 : -1;
  renderSuggestions();
}
function renderSuggestions() {
  const ac = document.getElementById('autocomplete');
  if (!state.suggestions.length) { ac.classList.remove('open'); return; }
  ac.innerHTML = state.suggestions.map((s, i) => {
    const isHi = i === state.highlighted;
    const hint = isHi ? '<span class="hint">↵ Enter</span>' : '';
    return `<div class="autocomplete-item${isHi ? ' highlighted' : ''}" data-idx="${i}"><span>${s.name}</span>${hint}</div>`;
  }).join('');
  ac.classList.add('open');
  ac.querySelectorAll('.autocomplete-item').forEach(el => {
    el.addEventListener('mousedown', (e) => {
      e.preventDefault();
      const idx = parseInt(el.dataset.idx);
      const sug = state.suggestions[idx];
      if (sug) submitAnswer(sug.name);
    });
  });
}
function hideAutocomplete() { document.getElementById('autocomplete').classList.remove('open'); state.suggestions = []; state.highlighted = -1; }

// ============ END ============
function endQuiz() {
  const pct = Math.round((state.score / state.pool.length) * 100);
  document.getElementById('final-score').textContent = state.score;
  document.getElementById('final-total').textContent = state.pool.length;
  document.getElementById('final-pct').textContent = pct;
  document.getElementById('final-streak').textContent = state.bestStreak;
  const regKey = 'reg_' + state.region;
  document.getElementById('final-region').textContent = i18n[state.lang][regKey] || state.region;

  const verdictEl = document.getElementById('verdict');
  let vKey = 'v_bad';
  if (pct === 100) vKey = 'v_perfect';
  else if (pct >= 80) vKey = 'v_great';
  else if (pct >= 50) vKey = 'v_ok';
  verdictEl.textContent = i18n[state.lang][vKey];

  const container = document.getElementById('mistakes-container');
  if (state.mistakes.length === 0) {
    container.innerHTML = `<div class="no-mistakes">${i18n[state.lang].no_mistakes}</div>`;
  } else {
    container.innerHTML = '<div class="mistakes-grid">' + state.mistakes.map(m => `
      <div class="mistake-card">
        <img src="${flagUrl(m)}" alt="${m[state.lang]}"
             onerror="this.outerHTML='<div class=&quot;mini-error&quot;>'+this.alt.substring(0,3).toUpperCase()+'</div>'">
        <div class="country">${m[state.lang]}</div>
      </div>
    `).join('') + '</div>';
  }
  showScreen('end');
}

// ============ EVENTS ============
document.addEventListener('DOMContentLoaded', () => {
  initLang();
  checkFlagsFolder();

  document.querySelectorAll('.lang-btn').forEach(b => {
    b.addEventListener('click', () => {
      state.lang = b.dataset.lang; applyLang();
      if (state.suggestions.length) updateSuggestions();
    });
  });

  document.querySelectorAll('input[name=count]').forEach(r => {
    r.addEventListener('change', () => {
      state.count = parseInt(r.value);
      document.getElementById('count-display').textContent = state.count;
    });
  });

  document.querySelectorAll('#region-chips .chip').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('#region-chips .chip').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      state.region = b.dataset.region;
      updateRegionDisplay();
    });
  });

  document.getElementById('start-btn').addEventListener('click', startQuiz);
  document.getElementById('restart-btn').addEventListener('click', () => showScreen('setup'));
  document.getElementById('skip-btn').addEventListener('click', skip);

  const input = document.getElementById('answer-input');
  input.addEventListener('input', updateSuggestions);
  input.addEventListener('keydown', (e) => {
    if (state.answered) { e.preventDefault(); return; }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (state.suggestions.length) {
        state.highlighted = (state.highlighted + 1) % state.suggestions.length;
        renderSuggestions();
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (state.suggestions.length) {
        state.highlighted = (state.highlighted - 1 + state.suggestions.length) % state.suggestions.length;
        renderSuggestions();
      }
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (state.highlighted >= 0 && state.suggestions[state.highlighted]) {
        submitAnswer(state.suggestions[state.highlighted].name);
      } else if (input.value.trim()) {
        submitAnswer(input.value.trim());
      }
    } else if (e.key === 'Tab') {
      if (state.suggestions.length) {
        e.preventDefault();
        input.value = state.suggestions[0].name;
        state.highlighted = 0;
        updateSuggestions();
      }
    } else if (e.key === 'Escape') { hideAutocomplete(); }
  });

  input.addEventListener('blur', () => { setTimeout(() => hideAutocomplete(), 150); });
});
</script>

