---
import AribaLayout from '../layouts/AribaLayout.astro';
import AribaNav from '../components/ariba/AribaNav.astro';
import AribaHero from '../components/ariba/AribaHero.astro';
import AribaCountdown from '../components/ariba/AribaCountdown.astro';
import AribaMatches from '../components/ariba/AribaMatches.astro';
import AribaSquad from '../components/ariba/AribaSquad.astro';
import AribaBoard from '../components/ariba/AribaBoard.astro';
import AribaHistory from '../components/ariba/AribaHistory.astro';
import AribaArticle from '../components/ariba/AribaArticle.astro';
import AribaSponsors from '../components/ariba/AribaSponsors.astro';
import AribaSponsorsSticky from '../components/ariba/AribaSponsorsSticky.astro';
import AribaSidebarKlas from '../components/ariba/AribaSidebarKlas.astro';
import AribaSidebarTopsc from '../components/ariba/AribaSidebarTopsc.astro';
import AribaKlassement from '../components/ariba/AribaKlassement.astro';
import AribaTopscorers from '../components/ariba/AribaTopscorers.astro';
import AribaSpelerModals from '../components/ariba/AribaSpelerModals.astro';
import AribaFooter from '../components/ariba/AribaFooter.astro';
---

<AribaLayout>
  <AribaNav />

  <div class="ariba-scroll-content">
    <AribaHero />

    <div class="ariba-layout-grid">
      <aside class="ariba-sidebar ariba-sidebar-left">
        <AribaSidebarKlas />
        <AribaSidebarTopsc />
      </aside>

      <main class="ariba-main-col">
        <AribaCountdown />
        <AribaMatches />
        <AribaSquad />
        <AribaBoard />
        <AribaHistory />
        <AribaArticle />
      </main>
    </div>

    <AribaSponsors />
    <AribaSponsorsSticky />
  </div>

  <AribaFooter />

  {/* Modals: klassement, topschutters, en per speler */}
  <div class="ariba-modal" id="modalKlas">
    <div class="ariba-modal-backdrop" data-close></div>
    <div class="ariba-modal-panel">
      <button class="ariba-modal-close" data-close aria-label="Sluiten">×</button>
      <div class="ariba-modal-body">
        <AribaKlassement />
      </div>
    </div>
  </div>

  <div class="ariba-modal" id="modalTopsc">
    <div class="ariba-modal-backdrop" data-close></div>
    <div class="ariba-modal-panel">
      <button class="ariba-modal-close" data-close aria-label="Sluiten">×</button>
      <div class="ariba-modal-body">
        <AribaTopscorers />
      </div>
    </div>
  </div>

  <AribaSpelerModals />

  <script is:inline>
    (function(){
      document.querySelectorAll('[data-modal]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var m = document.getElementById(btn.getAttribute('data-modal'));
          if (m) { m.classList.add('open'); document.body.style.overflow = 'hidden'; }
        });
      });
      document.querySelectorAll('[data-close]').forEach(function(el){
        el.addEventListener('click', function(){
          var m = el.closest('.ariba-modal');
          if (m) { m.classList.remove('open'); document.body.style.overflow = ''; }
        });
      });
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') {
          document.querySelectorAll('.ariba-modal.open').forEach(function(m){ m.classList.remove('open'); });
          document.body.style.overflow = '';
        }
      });
    })();
  </script>
</AribaLayout>
